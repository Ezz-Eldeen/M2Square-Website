---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoImg from '../../assets/Logo.png';
---

<Layout
  title="من نحن - إم سكوير | حلول برمجية للمؤسسات"
  description="تعرّف على إم سكوير. نبني البنية التحتية التي تدير أعمال الشركات، من منصات ERP المخصصة والفوترة الإلكترونية إلى الويب والجوال والبنية التحتية الآمنة."
>
  <!--
    Arabic fonts: 'IBM Plex Sans' and 'Sora' (used on the English page)
    have no Arabic glyphs, so this page loads Arabic-covering equivalents
    with the closest matching weight/personality — 'IBM Plex Sans Arabic'
    for body text, 'Cairo' standing in for the geometric feel of 'Sora'
    in headings. Both fall back to the original Latin fonts for any
    stray Latin characters (brand name, "ERP", etc.).
  -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Cairo:wght@600;700&family=Sora:wght@600;700&display=swap"
  />

  <!--
    RTL is applied locally to this page (dir + CSS direction: rtl) rather
    than relying on Layout.astro, since Layout is shared with every LTR
    page on the site. If Layout.astro accepts a lang/dir prop already,
    pass lang="ar" dir="rtl" to it instead of doing it here — but this
    works standalone either way.
  -->
  <main class="about-page" dir="rtl" lang="ar">
    <div class="ambient" aria-hidden="true"></div>

    <!-- Hero Section -->
    <section class="section hero-section">
      <div class="container hero-container">
        <div class="hero-content hero-copy">
          <div class="eyebrow">
            <span class="status-dot"></span>
            <span>عن إم-سكوير</span>
          </div>
          <h1>نبني البنية التحتية التي تدير أعمالك.</h1>
          <p class="lede">
            حلول برمجية للمؤسسات، مصمَّمة بدقة من أجل الأداء والأمان والامتثال الكامل.
          </p>
        </div>

        <!-- Trust Metrics / Stats Row -->
        <div class="stats-row fact-row">
          <div class="stat-item fact">
            <dt>الخبرة</dt>
            <dd>+5</dd>
          </div>
          <div class="stat-item fact">
            <dt>التركيز</dt>
            <dd>100%</dd>
          </div>
          <div class="stat-item fact">
            <dt>الدعم</dt>
            <dd>24/7</dd>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Story Section -->
    <section class="section who-we-are-section">
      <div class="container split-layout">
        <div class="image-box hero-mark">
          <div class="logo-wrapper">
             <div class="mark-glow"></div>
             <Image src={logoImg} alt="شعار إم-سكوير" class="floating-logo mark-logo" />
             <div class="glow-effect"></div>
          </div>
        </div>
        <div class="text-box">
          <h2>قصتنا</h2>
          <p>
            في عام 2021، حدد مؤسسونا فجوة جوهرية: احتاجت الشركات في مصر إلى طريقة حديثة
            وخالية من التعقيد للامتثال لنظام الفوترة الإلكترونية الجديد الصادر عن مصلحة
            الضرائب المصرية.
          </p>
          <p>
            جمعوا فريقًا من المتخصصين وبنوا حلاً بسّط عملية الفوترة وضمِن الامتثال التنظيمي
            الكامل منذ اليوم الأول. أصبح نجاح هذا المشروع الأساس لشيء أكبر — واليوم، تطورت
            إم-سكوير لتصبح شريكًا رقميًا متكامل الخدمات، تقدّم منصات تخطيط موارد المؤسسات
            (ERP) المخصصة، ومواقع وتطبيقات جوال عالية الأداء، وبنية تحتية تقنية آمنة لبعض
            أبرز المؤسسات في المنطقة.
          </p>
        </div>
      </div>
    </section>

    <!-- Vision & Mission Section -->
    <section class="section vision-mission-section">
      <div class="container">
        <div class="grid-2">
          <div class="card vm-card vision-card">
            <div class="icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            </div>
            <h3>رؤيتنا</h3>
            <p>
              أن نكون الركيزة الرقمية الموثوقة للشركات الطموحة في مصر والمنطقة — الشريك الذي
              تلجأ إليه المؤسسات حين تحتاج إلى أن تعمل عملياتها وامتثالها وتقنيتها كنظام واحد
              متكامل.
            </p>
          </div>
          <div class="card vm-card mission-card">
            <div class="icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>مهمتنا</h3>
            <p>
              تصميم وبناء ودعم برمجيات وبنية تحتية ذكية مدعومة بالذكاء الاصطناعي — من تخطيط
              موارد المؤسسات والامتثال الضريبي الإلكتروني إلى المواقع الإلكترونية وتطبيقات
              الجوال والشبكات الآمنة — لتبسيط طريقة عمل عملائنا، وضمان امتثالهم الكامل، ومنحهم
              الأساس التقني للتوسّع بثقة.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Values Section -->
    <section class="section values-section">
      <div class="container">
        <div class="section-header center">
          <h2>قيمنا الأساسية</h2>
        </div>

        <div class="grid-3 values-grid">
          <div class="value-item">
            <h4>ابتكار له هدف</h4>
            <p>نتبنّى الذكاء الاصطناعي والأتمتة حيثما تُحسّن النتائج فعليًا، لا لمجرد التبني.</p>
          </div>
          <div class="value-item">
            <h4>شراكة حقيقية</h4>
            <p>نعمل جنبًا إلى جنب مع فريقك، لا من مسافة.</p>
          </div>
          <div class="value-item">
            <h4>النزاهة</h4>
            <p>جداول زمنية شفافة، وتحديد نطاق صادق، ومساءلة في كل مرحلة.</p>
          </div>
          <div class="value-item">
            <h4>الدقة والموثوقية</h4>
            <p>أنظمة مبنية لتعمل دون مفاجآت، مدعومة باختبارات صارمة ودعم مستمر.</p>
          </div>
          <div class="value-item">
            <h4>الامتثال أولًا</h4>
            <p>نواكب التغييرات التنظيمية باستمرار حتى لا يقلق عملاؤنا بشأنها أبدًا.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Capabilities / What We Build CTA -->
    <section class="section capabilities-section">
      <div class="container">
        <div class="cta-box build-strip">
          <h2>ما نبنيه</h2>
          <div class="tags-wrapper">
            <span class="tech-tag">تخطيط موارد المؤسسات (ERP)</span>
            <span class="tech-tag">الفوترة الإلكترونية</span>
            <span class="tech-tag">الويب</span>
            <span class="tech-tag">الجوال</span>
            <span class="tech-tag">البنية التحتية</span>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
.about-page {
    /* M-Square brand: Blue #076CC7 · Gold #D29D52 · Midnight Navy #03111F */
    --bg: #03111F;
    --panel: #061a2e;
    --border: rgba(255, 255, 255, 0.09);
    --text-primary: #f5f7fa;
    --text-secondary: #a9bbcd;
    --text-tertiary: #7189a1;
    --accent: #D29D52;
    --accent-soft: #F6C973;
    --blue: #076CC7;
    --blue-light: #3BAAEF;

    direction: rtl;
    background-color: var(--bg);
    color: var(--text-primary);
    font-family: 'IBM Plex Sans Arabic', 'IBM Plex Sans', system-ui, sans-serif;
    line-height: 1.7;
    overflow-x: hidden;
    position: relative;
}

.ambient {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 50% 40% at 80% 0%, rgba(210, 157, 82, 0.12) 0%, transparent 60%),
    radial-gradient(ellipse 55% 45% at 15% 65%, rgba(7, 108, 199, 0.16) 0%, transparent 65%);
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
  position: relative;
  z-index: 1;
}

.section { padding: 5rem 0; }

.section-header.center {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 3.5rem;
}

.section-header h2 {
  font-size: 2.25rem;
  margin-bottom: 1rem;
}

/* --- Hero Section --- */
.hero-section { padding-top: 8rem; padding-bottom: 4rem; }

.hero-content {
  text-align: center;
  max-width: 900px;
  margin: 0 auto 4rem;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.4rem 0.85rem;
  border: 1px solid rgba(210, 157, 82, 0.3);
  border-radius: 999px;
  background: var(--panel);
  font-size: 0.8125rem;
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  animation: pulseDot 3s ease-in-out infinite;
}

h1 {
  font-family: 'Cairo', 'Sora', 'IBM Plex Sans Arabic', system-ui, sans-serif;
  font-weight: 700;
  font-size: clamp(2.25rem, 5vw, 3.75rem);
  line-height: 1.35;
  margin-bottom: 1.5rem;
  color: var(--text-primary);
}

.hero-copy p {
  font-size: 1.0625rem;
  line-height: 1.8;
  color: var(--text-secondary);
  max-width: 52ch;
  margin: 0 auto 1rem;
}

.hero-copy p.lede {
  color: var(--text-primary);
  font-size: 1.125rem;
}

.stats-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 2rem;
  padding-top: 3rem;
  border-top: 1px solid var(--border);
}

.fact { flex: 1 1 200px; text-align: center; }

.fact dt {
  font-size: 0.8125rem;
  color: var(--text-tertiary);
  margin: 0 0 0.35rem;
}

.fact dd {
  font-family: 'Cairo', 'Sora', 'IBM Plex Sans Arabic', system-ui, sans-serif;
  font-size: 2.75rem;
  font-weight: 700;
  color: var(--accent);
  margin: 0;
  line-height: 1;
  direction: ltr; /* keeps "24/7" and "100%" reading left-to-right within the RTL page */
  unicode-bidi: isolate;
}

/* --- Our Story Section --- */
.who-we-are-section { background-color: var(--panel); }

.split-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 4rem;
  align-items: center;
}

@media (min-width: 992px) {
  .split-layout { grid-template-columns: 1fr 1fr; }
}

.hero-mark {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 3rem;
}

.mark-glow {
  position: absolute;
  inset: -30%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(210, 157, 82, 0.32) 0%, rgba(7, 108, 199, 0.12) 45%, rgba(7, 108, 199, 0) 70%);
  animation: fastBreath 2.5s ease-in-out infinite;
}

.mark-logo { position: relative; width: 250px; height: 250px; }

.glow-effect {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  background: var(--accent);
  filter: blur(100px);
  opacity: 0.2;
  z-index: 0;
}

.floating-logo {
  position: relative;
  z-index: 1;
  width: 100%;
  height: auto;
  animation: float 6s ease-in-out infinite;
}

.text-box h2 {
  font-family: 'Cairo', 'Sora', 'IBM Plex Sans Arabic', system-ui, sans-serif;
  font-size: 2.25rem;
  margin-bottom: 1.5rem;
  color: var(--text-primary);
}

.text-box p {
  color: var(--text-secondary);
  margin-bottom: 1.25rem;
  font-size: 1.05rem;
}

/* --- Vision & Mission Section --- */
.grid-2 { display: grid; grid-template-columns: 1fr; gap: 2rem; }
@media (min-width: 768px) { .grid-2 { grid-template-columns: 1fr 1fr; } }

.vm-card {
  background: var(--panel);
  border: 1px solid var(--border);
  padding: 3rem;
  border-radius: 1rem;
  transition: transform 0.3s ease;
}
.vm-card:hover { transform: translateY(-5px); border-color: rgba(210, 157, 82, 0.45); }

.icon-wrapper {
  width: 60px;
  height: 60px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  margin-bottom: 1.5rem;
}

.vm-card h3 {
  font-family: 'Cairo', 'Sora', 'IBM Plex Sans Arabic', system-ui, sans-serif;
  font-size: 1.6rem;
  margin-bottom: 1rem;
  color: var(--text-primary);
}
.vm-card p { color: var(--text-secondary); }

/* --- Values Section --- */
.values-section { background-color: var(--panel); }

.grid-3 { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
@media (min-width: 768px) { .grid-3 { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .grid-3 { grid-template-columns: repeat(3, 1fr); } }

.value-item {
  background: var(--bg);
  padding: 2rem;
  border-radius: 0.75rem;
  border: 1px solid var(--border);
  border-top: 3px solid var(--accent);
}

.value-item h4 {
  font-family: 'Cairo', 'Sora', 'IBM Plex Sans Arabic', system-ui, sans-serif;
  font-size: 1.15rem;
  margin-bottom: 0.75rem;
  color: var(--text-primary);
  margin-top: 0;
}
.value-item p { color: var(--text-secondary); font-size: 0.95rem; margin: 0; }

/* --- Capabilities Section --- */
.capabilities-section { padding-bottom: 8rem; }

.cta-box {
  background: linear-gradient(145deg, var(--panel) 0%, var(--bg) 100%);
  border: 1px solid var(--border);
  border-radius: 1.5rem;
  padding: 4rem 2rem;
  text-align: center;
}

.cta-box h2 {
  font-family: 'Cairo', 'Sora', 'IBM Plex Sans Arabic', system-ui, sans-serif;
  font-size: 2.1rem;
  margin-bottom: 2.5rem;
  color: var(--text-primary);
}

.tags-wrapper {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

.tech-tag {
  background: var(--bg);
  border: 1px solid rgba(210, 157, 82, 0.3);
  color: var(--text-primary);
  padding: 0.75rem 1.5rem;
  border-radius: 50px;
  font-weight: 500;
  transition: all 0.3s ease;
}
.tech-tag:hover { background: var(--accent); color: #fff; border-color: var(--accent); }

/* --- Animations --- */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}
@keyframes fastBreath {
  0%, 100% { transform: translate(0, 0) scale(0.85); opacity: 0.4; }
  50% { transform: translate(0, 0) scale(1.35); opacity: 0.85; }
}
@keyframes pulseDot {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .floating-logo, .mark-glow { animation: none; }
}
</style>