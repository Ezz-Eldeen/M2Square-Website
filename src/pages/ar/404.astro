---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedPath, type Lang } from '../../i18n/utils';
import logoImg from '../../assets/logo.png';

const lang = (Astro.currentLocale ?? 'ar') as Lang;
const homeHref = getLocalizedPath('/', lang);
---

<Layout title="الصفحة غير موجودة - إم-سكوير">
  <!-- Loads the icon font directly so the material-symbols-outlined span below
       actually renders as an icon instead of printing its raw ligature name -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
  />

  <main class="error-main relative min-h-screen flex flex-col items-center justify-center px-6 pt-32 sm:pt-40 pb-16 overflow-hidden bg-[var(--color-bg)] text-white">
    <!-- Ambient glow background, same treatment as the rest of the site -->
    <div class="error-ambient" aria-hidden="true"></div>

    <!-- Drifting starfield, reused pattern from the about page -->
    <div class="error-starfield" aria-hidden="true">
      <span class="star" style="top:12%; left:10%; --size:2px; --delay:0s; --dur:8s; --drift:16px; --tint:var(--color-tertiary);"></span>
      <span class="star" style="top:20%; left:82%; --size:1.5px; --delay:1.2s; --dur:9s; --drift:10px; --tint:var(--color-primary);"></span>
      <span class="star" style="top:34%; left:22%; --size:2px; --delay:0.5s; --dur:7.5s; --drift:14px; --tint:var(--color-secondary);"></span>
      <span class="star" style="top:46%; left:68%; --size:2.5px; --delay:2s; --dur:10s; --drift:18px; --tint:var(--color-tertiary);"></span>
      <span class="star" style="top:60%; left:14%; --size:1.5px; --delay:0.8s; --dur:8.5s; --drift:12px; --tint:var(--color-primary);"></span>
      <span class="star" style="top:70%; left:88%; --size:2px; --delay:1.6s; --dur:7s; --drift:16px; --tint:#ffffff;"></span>
      <span class="star" style="top:80%; left:40%; --size:2.5px; --delay:0.3s; --dur:9.5s; --drift:20px; --tint:var(--color-primary);"></span>
      <span class="star" style="top:88%; left:60%; --size:1.5px; --delay:2.4s; --dur:8s; --drift:10px; --tint:var(--color-secondary);"></span>
    </div>

    <!-- Recolored, glowing logo standing in for the classic "404 astronaut" -->
    <div class="error-logo-frame">
      <div class="error-logo-glow"></div>
      <div class="error-logo-ring"></div>
      <div class="error-logo-ring error-logo-ring-2"></div>
      <img src={logoImg.src} alt="M2-Square" class="error-logo-img" />
    </div>

    <span class="font-mono text-xs sm:text-sm text-[var(--color-primary)] uppercase tracking-widest mb-4 mt-8">
      خطأ 404
    </span>

    <h1 class="text-4xl sm:text-6xl font-bold text-[var(--color-text)] mb-4 text-center leading-[1.4] max-w-2xl">
      هذه <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-tertiary)] pb-1 inline-block">الصفحة</span> غير مقيّدة في السجل.
    </h1>

    <p class="error-desc text-[var(--color-text-secondary)] text-base sm:text-lg text-center mb-10 leading-relaxed">
      الصفحة التي تبحث عنها غير موجودة أو ربما تم نقلها. كل شيء آخر في مكانه الصحيح تمامًا.
    </p>

    <a href={homeHref} class="error-btn relative inline-flex items-center gap-2 px-8 py-4 rounded-xl text-white font-semibold text-sm tracking-wide shadow-[0_0_20px_color-mix(in_srgb,var(--color-primary)_40%,transparent)] hover:scale-105 transition-transform duration-300 overflow-hidden">
      <span class="material-symbols-outlined text-lg relative z-10">arrow_forward</span>
      <span class="relative z-10">العودة إلى الصفحة الرئيسية</span>
    </a>
  </main>
</Layout>

<style>
.material-symbols-outlined {
  font-family: 'Material Symbols Outlined';
  font-weight: normal;
  font-style: normal;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-feature-settings: 'liga';
  -webkit-font-smoothing: antialiased;
}

.error-desc {
  display: block;
  width: 100% !important;
  max-width: 28rem;
  margin-left: auto;
  margin-right: auto;
}
.error-main {
  isolation: isolate;
}

.error-ambient {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 60% 50% at 50% 20%, color-mix(in srgb, var(--color-primary) 16%, transparent) 0%, transparent 65%),
    radial-gradient(ellipse 50% 40% at 15% 80%, color-mix(in srgb, var(--color-secondary) 8%, transparent) 0%, transparent 60%),
    radial-gradient(ellipse 55% 45% at 85% 85%, color-mix(in srgb, var(--color-tertiary) 8%, transparent) 0%, transparent 60%);
}

.error-starfield {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}
.star {
  position: absolute;
  width: var(--size, 2px);
  height: var(--size, 2px);
  border-radius: 50%;
  background: var(--tint, #fff);
  box-shadow: 0 0 6px 1px currentColor;
  opacity: 0.6;
  animation: starDrift var(--dur, 8s) ease-in-out infinite;
  animation-delay: var(--delay, 0s);
}
@keyframes starDrift {
  0%, 100% { transform: translateY(0); opacity: 0.35; }
  50% { transform: translateY(calc(-1 * var(--drift, 14px))); opacity: 0.9; }
}

.error-logo-frame {
  position: relative;
  z-index: 1;
  width: 200px;
  height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
}
@media (min-width: 640px) {
  .error-logo-frame { width: 260px; height: 260px; }
}

.error-logo-glow {
  position: absolute;
  width: 220%;
  height: 220%;
  background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 40%, transparent) 0%, transparent 70%);
  border-radius: 50%;
  filter: blur(20px);
  animation: errorBreath 3s ease-in-out infinite;
  z-index: 0;
  pointer-events: none;
}

.error-logo-ring {
  position: absolute;
  inset: -18px;
  border-radius: 50%;
  border: 1.5px dashed color-mix(in srgb, var(--color-primary) 50%, transparent);
  animation: errorSpin 18s linear infinite;
  pointer-events: none;
  z-index: 1;
}
.error-logo-ring-2 {
  inset: -36px;
  border: 1px solid color-mix(in srgb, var(--color-secondary) 25%, transparent);
  animation: errorSpinReverse 26s linear infinite;
}

.error-logo-img {
  position: relative;
  width: 68%;
  height: 68%;
  object-fit: contain;
  z-index: 2;
  filter: grayscale(1) brightness(1.5) contrast(1.15) drop-shadow(0 0 30px color-mix(in srgb, var(--color-primary) 60%, transparent));
  animation: errorLogoFloat 4s ease-in-out infinite;
}

.error-logo-frame::after {
  content: '';
  position: absolute;
  width: 68%;
  height: 68%;
  background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 90%, transparent) 0%, color-mix(in srgb, var(--color-tertiary) 50%, transparent) 55%, transparent 80%);
  mix-blend-mode: color;
  z-index: 3;
  pointer-events: none;
  border-radius: 50%;
}

@keyframes errorBreath {
  0%, 100% { opacity: 0.5; transform: scale(0.9); }
  50% { opacity: 0.9; transform: scale(1.15); }
}
@keyframes errorSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
@keyframes errorSpinReverse {
  from { transform: rotate(360deg); }
  to { transform: rotate(0deg); }
}
@keyframes errorLogoFloat {
  0%, 100% { transform: translateY(0); filter: grayscale(1) brightness(1.5) contrast(1.15) drop-shadow(0 0 25px color-mix(in srgb, var(--color-primary) 55%, transparent)); }
  50% { transform: translateY(-10px); filter: grayscale(1) brightness(1.6) contrast(1.2) drop-shadow(0 0 45px color-mix(in srgb, var(--color-primary) 85%, transparent)); }
}

/* Flat solid CTA button, matching the site's damped-down button style */
.error-btn {
  background-color: var(--color-primary);
}
.error-btn:hover {
  background-color: var(--color-primary-hover);
}

.error-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(115deg, transparent 20%, rgba(255, 255, 255, 0.45) 45%, transparent 60%);
  transform: translateX(-120%);
}
.error-btn:hover::before {
  animation: errorShine 0.9s ease-in-out;
}
@keyframes errorShine {
  from { transform: translateX(-120%); }
  to { transform: translateX(120%); }
}

@media (prefers-reduced-motion: reduce) {
  .star, .error-logo-glow, .error-logo-ring, .error-logo-ring-2, .error-logo-img, .error-btn::before {
    animation: none !important;
  }
}
</style>