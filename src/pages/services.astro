---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services and Solutions - M2-Square">
  <main class="pt-32 pb-32 px-6 max-w-[1440px] mx-auto relative z-10 bg-[radial-gradient(ellipse_120%_60%_at_50%_-10%,_#1a1310_0%,_#0a0a0c_55%,_#08080a_100%)] text-white overflow-hidden">
    <div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-[#ff6a2b]/5 blur-[150px] rounded-full pointer-events-none z-0"></div>
    <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-[#ffb59a]/5 blur-[120px] rounded-full pointer-events-none z-0"></div>

    <!-- Hero -->
    <section class="max-w-3xl mb-16 relative z-10">
      <h1 class="text-4xl sm:text-6xl font-bold text-[#F5F5F4] mb-6 leading-tight tracking-tight">
        Engineering precision across digital infrastructure.
      </h1>
      <p class="text-base sm:text-lg text-[#A3A3AA] max-w-2xl leading-relaxed">
        We deliver uncompromising technical solutions across four core pillars. Built for scale, secured by design, and engineered for high-performance environments.
      </p>
    </section>

    <!-- Services Bento Grid -->
    <section class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Cyber Security -->
      <div id="cyber-security" class="scroll-mt-24 group relative bg-[#131316]/60 border border-white/10 backdrop-blur-xl rounded-3xl p-10 transition-all duration-300 hover:border-[#ff6a2b]/40 hover:-translate-y-1 overflow-hidden flex flex-col h-full min-h-[320px] shadow-lg">
        <div class="absolute top-0 left-0 w-1 h-full bg-[#ff6a2b] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="mb-auto relative z-10">
          <span class="material-symbols-outlined text-[#A3A3AA] group-hover:text-[#ff6a2b] text-4xl mb-6 transition-colors duration-300" style="font-variation-settings: 'FILL' 1;">security</span>
          <h2 class="text-2xl font-semibold text-[#F5F5F4] mb-3">Cyber Security</h2>
          <p class="text-[#A3A3AA] leading-relaxed">
            Advanced threat detection, zero-trust architecture implementation, and comprehensive vulnerability management. We secure your digital perimeter with military-grade protocols and continuous monitoring.
          </p>
        </div>
        <div class="mt-6 relative z-10">
          <a class="inline-flex items-center text-[#A3A3AA] group-hover:text-[#ff6a2b] transition-colors duration-300" href="/contact">
            Explore Protocols <span class="material-symbols-outlined ml-2 text-[18px]">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Digital Transformation -->
      <div id="digital-transformation" class="scroll-mt-24 group relative bg-[#131316]/60 border border-white/10 backdrop-blur-xl rounded-3xl p-10 transition-all duration-300 hover:border-[#ff6a2b]/40 hover:-translate-y-1 overflow-hidden flex flex-col h-full min-h-[320px] shadow-lg">
        <div class="absolute top-0 left-0 w-1 h-full bg-[#ff6a2b] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="mb-auto relative z-10">
          <span class="material-symbols-outlined text-[#A3A3AA] group-hover:text-[#ff6a2b] text-4xl mb-6 transition-colors duration-300" style="font-variation-settings: 'FILL' 1;">architecture</span>
          <h2 class="text-2xl font-semibold text-[#F5F5F4] mb-3">Digital Transformation</h2>
          <p class="text-[#A3A3AA] leading-relaxed">
            Modernize legacy systems and orchestrate cloud-native migrations. We build scalable microservices and automate deployment pipelines to accelerate technical velocity.
          </p>
        </div>
        <div class="mt-6 relative z-10">
          <a class="inline-flex items-center text-[#A3A3AA] group-hover:text-[#ff6a2b] transition-colors duration-300" href="/contact">
            View Methodologies <span class="material-symbols-outlined ml-2 text-[18px]">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Project Management -->
      <div id="project-management" class="scroll-mt-24 group relative bg-[#131316]/60 border border-white/10 backdrop-blur-xl rounded-3xl p-10 transition-all duration-300 hover:border-[#ff6a2b]/40 hover:-translate-y-1 overflow-hidden flex flex-col h-full min-h-[320px] shadow-lg">
        <div class="absolute top-0 left-0 w-1 h-full bg-[#ff6a2b] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="mb-auto relative z-10">
          <span class="material-symbols-outlined text-[#A3A3AA] group-hover:text-[#ff6a2b] text-4xl mb-6 transition-colors duration-300" style="font-variation-settings: 'FILL' 1;">account_tree</span>
          <h2 class="text-2xl font-semibold text-[#F5F5F4] mb-3">Project Management</h2>
          <p class="text-[#A3A3AA] leading-relaxed">
            Rigorous technical oversight for complex IT initiatives. Utilizing agile frameworks and precise resource allocation to ensure delivery on strict engineering timelines.
          </p>
        </div>
        <div class="mt-6 relative z-10">
          <a class="inline-flex items-center text-[#A3A3AA] group-hover:text-[#ff6a2b] transition-colors duration-300" href="/contact">
            Review Frameworks <span class="material-symbols-outlined ml-2 text-[18px]">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- E-Taxes Solutions -->
      <div id="e-taxes-solutions" class="scroll-mt-24 group relative bg-[#131316]/60 border border-white/10 backdrop-blur-xl rounded-3xl p-10 transition-all duration-300 hover:border-[#ff6a2b]/40 hover:-translate-y-1 overflow-hidden flex flex-col h-full min-h-[320px] shadow-lg">
        <div class="absolute top-0 left-0 w-1 h-full bg-[#ff6a2b] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="mb-auto relative z-10">
          <span class="material-symbols-outlined text-[#A3A3AA] group-hover:text-[#ff6a2b] text-4xl mb-6 transition-colors duration-300" style="font-variation-settings: 'FILL' 1;">receipt_long</span>
          <h2 class="text-2xl font-semibold text-[#F5F5F4] mb-3">E-Taxes Solutions</h2>
          <p class="text-[#A3A3AA] leading-relaxed">
            Secure, compliant, and highly available fiscal infrastructure. We develop integrated e-invoicing and tax compliance platforms engineered to handle high-throughput transactional data.
          </p>
        </div>
        <div class="mt-6 relative z-10">
          <a class="inline-flex items-center text-[#A3A3AA] group-hover:text-[#ff6a2b] transition-colors duration-300" href="/contact">
            Examine Specs <span class="material-symbols-outlined ml-2 text-[18px]">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Technical Stats/Info Section -->
    <section class="mt-24 relative z-10 bg-[#1C1C20]/60 border border-white/10 backdrop-blur-xl rounded-3xl p-10 md:p-16 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-[#ff6a2b]/5 to-transparent pointer-events-none"></div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
        <div>
          <div class="font-mono text-[#ff6a2b] mb-2 text-2xl">99.999%</div>
          <div class="text-[#A3A3AA] uppercase tracking-widest text-sm">SLA Uptime</div>
        </div>
        <div>
          <div class="font-mono text-[#ff6a2b] mb-2 text-2xl">ISO 27001</div>
          <div class="text-[#A3A3AA] uppercase tracking-widest text-sm">Certified Protocols</div>
        </div>
        <div>
          <div class="font-mono text-[#ff6a2b] mb-2 text-2xl">&lt; 50ms</div>
          <div class="text-[#A3A3AA] uppercase tracking-widest text-sm">API Latency</div>
        </div>
      </div>
    </section>
  </main>
</Layout>