---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us - M2-Square"
  description="Contact M-Square to discuss ERP, e-invoicing, web, mobile or IT infrastructure projects. Talk to our team in Alexandria, Egypt for a consultation or quote."
>
  <!-- Icon font: needed for the material-symbols-outlined spans below -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
  />

  <main class="pt-32 pb-24 px-6 max-w-[1440px] mx-auto relative z-10 bg-[var(--color-bg)] text-white overflow-hidden">
    <!-- Global ambient background: fixed layer of plain radial-gradients (no blur filter) -->
    <div class="ambient-bg" aria-hidden="true"></div>

    <!-- Scroll-following spotlight -->
    <div id="scroll-light" class="scroll-light" aria-hidden="true"></div>

    <!-- 1. HERO -->
    <div class="max-w-3xl relative z-10 mb-12">
      <div class="pop-card is-visible inline-flex items-center gap-2 border border-[var(--color-primary)]/25 bg-[var(--color-surface)]/80 backdrop-blur-md px-4 py-1.5 rounded-full mb-6 shadow-md">
        <span class="w-2 h-2 rounded-full bg-[#3DD68C] animate-pulse shadow-[0_0_8px_rgba(61,214,140,0.8)]"></span>
        <span class="font-mono text-xs text-[var(--color-text-secondary)] uppercase tracking-widest">Response SLA under 4 hours</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-bold text-[var(--color-text)] mb-4 leading-tight tracking-tight">
        Initialize <span class="gold-text drop-shadow-[0_0_20px_color-mix(in_srgb,var(--color-primary)_30%,transparent)]">Connection</span>
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-2xl mb-8">
        Secure transmission channel for technical inquiries, system integration support, and deployment assistance. Establish contact with an M2-Square operative.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="#contact-form" class="gold-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-semibold text-sm tracking-wide shadow-[0_0_15px_color-mix(in_srgb,var(--color-primary)_25%,transparent)] hover:shadow-[0_0_25px_color-mix(in_srgb,var(--color-primary)_50%,transparent)] hover:scale-105 transition-all duration-300">
          Send a Message
          <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
        </a>
        <a href="mailto:sales@m2-square.com" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-white/15 bg-[var(--color-surface)]/60 backdrop-blur-md text-[var(--color-text)] font-semibold text-sm tracking-wide hover:border-[var(--color-primary)]/60 hover:text-[var(--color-tertiary)] transition-all duration-300">
          <span class="material-symbols-outlined text-[18px]">mail</span>
          Email Direct
        </a>
      </div>
    </div>

    <!-- 2. TRUST / SERVICE STRIP -->
    <div class="relative z-10 grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      <div class="pop-card p-5 text-center bg-[var(--color-surface)]/50 border border-white/5 rounded-2xl backdrop-blur-md">
        <span class="material-symbols-outlined text-2xl text-[var(--color-primary)] mb-2 block">bolt</span>
        <div class="font-mono text-sm font-semibold text-[var(--color-text)]">&lt; 4h</div>
        <div class="text-[11px] text-[var(--color-text-secondary)] uppercase tracking-wider mt-1">Response Time</div>
      </div>
      <div class="pop-card p-5 text-center bg-[var(--color-surface)]/50 border border-white/5 rounded-2xl backdrop-blur-md">
        <span class="material-symbols-outlined text-2xl text-[var(--color-primary)] mb-2 block">shield_lock</span>
        <div class="font-mono text-sm font-semibold text-[var(--color-text)]">SSL</div>
        <div class="text-[11px] text-[var(--color-text-secondary)] uppercase tracking-wider mt-1">Encrypted Channel</div>
      </div>
      <div class="pop-card p-5 text-center bg-[var(--color-surface)]/50 border border-white/5 rounded-2xl backdrop-blur-md">
        <span class="material-symbols-outlined text-2xl text-[var(--color-primary)] mb-2 block">engineering</span>
        <div class="font-mono text-sm font-semibold text-[var(--color-text)]">Dedicated</div>
        <div class="text-[11px] text-[var(--color-text-secondary)] uppercase tracking-wider mt-1">Deployment Engineer</div>
      </div>
      <div class="pop-card p-5 text-center bg-[var(--color-surface)]/50 border border-white/5 rounded-2xl backdrop-blur-md">
        <span class="material-symbols-outlined text-2xl text-[var(--color-primary)] mb-2 block">description</span>
        <div class="font-mono text-sm font-semibold text-[var(--color-text)]">On Request</div>
        <div class="text-[11px] text-[var(--color-text-secondary)] uppercase tracking-wider mt-1">NDA Available</div>
      </div>
    </div>

    <!-- 3. CONTENT GRID -->
    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Contact form -->
      <div id="contact-form" class="pop-card lg:col-span-8 w-full scroll-mt-24">
        <div class="bg-[var(--color-surface)]/70 border border-white/10 backdrop-blur-xl rounded-3xl p-8 relative overflow-hidden shadow-2xl">
          <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[var(--color-primary)]/50 to-transparent"></div>

          <form action="#" method="POST" class="space-y-6 relative z-10">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-[var(--color-text-secondary)]" for="name">
                  <span class="material-symbols-outlined text-[16px] text-[var(--color-primary)]">person</span>Full Name <span class="text-[var(--color-primary)]">*</span>
                </label>
                <input class="w-full bg-[var(--color-surface-alt)] border border-white/10 rounded-xl px-4 py-3 text-[var(--color-text)] focus:border-[var(--color-primary)] focus:ring-0 focus:outline-none transition-all placeholder:text-[var(--color-text-tertiary)]" id="name" name="name" placeholder="Enter full name" required type="text" />
              </div>
              <div class="space-y-2">
                <label class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-[var(--color-text-secondary)]" for="company">
                  <span class="material-symbols-outlined text-[16px] text-[var(--color-primary)]">apartment</span>Company
                </label>
                <input class="w-full bg-[var(--color-surface-alt)] border border-white/10 rounded-xl px-4 py-3 text-[var(--color-text)] focus:border-[var(--color-primary)] focus:ring-0 focus:outline-none transition-all placeholder:text-[var(--color-text-tertiary)]" id="company" name="company" placeholder="Company name" type="text" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-[var(--color-text-secondary)]" for="email">
                  <span class="material-symbols-outlined text-[16px] text-[var(--color-primary)]">mail</span>Email Address <span class="text-[var(--color-primary)]">*</span>
                </label>
                <input class="w-full bg-[var(--color-surface-alt)] border border-white/10 rounded-xl px-4 py-3 text-[var(--color-text)] focus:border-[var(--color-primary)] focus:ring-0 focus:outline-none transition-all placeholder:text-[var(--color-text-tertiary)]" id="email" name="email" placeholder="sales@m2-square.com" required type="email" />
              </div>
              <div class="space-y-2">
                <label class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-[var(--color-text-secondary)]" for="phone">
                  <span class="material-symbols-outlined text-[16px] text-[var(--color-primary)]">phone</span>Phone Number
                </label>
                <input class="w-full bg-[var(--color-surface-alt)] border border-white/10 rounded-xl px-4 py-3 text-[var(--color-text)] focus:border-[var(--color-primary)] focus:ring-0 focus:outline-none transition-all placeholder:text-[var(--color-text-tertiary)]" id="phone" name="phone" placeholder="0155 357 7554" type="tel" />
              </div>
            </div>

            <div class="space-y-2">
              <label class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-[var(--color-text-secondary)]" for="subject">
                <span class="material-symbols-outlined text-[16px] text-[var(--color-primary)]">tag</span>Subject
              </label>
              <select class="w-full bg-[var(--color-surface-alt)] border border-white/10 rounded-xl px-4 py-3 text-[var(--color-text)] focus:border-[var(--color-primary)] focus:ring-0 focus:outline-none transition-all cursor-pointer" id="subject" name="subject">
                <option value="technical">Technical Support</option>
                <option value="deployment">Deployment Coordination</option>
                <option value="security">Security Audit Request</option>
                <option value="sales">Sales & Pricing</option>
                <option value="other">General Inquiry</option>
              </select>
            </div>

            <div class="space-y-2">
              <label class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-[var(--color-text-secondary)]" for="message">
                <span class="material-symbols-outlined text-[16px] text-[var(--color-primary)]">terminal</span>Message <span class="text-[var(--color-primary)]">*</span>
              </label>
              <textarea class="w-full bg-[var(--color-surface-alt)] border border-white/10 rounded-xl px-4 py-3 text-[var(--color-text)] focus:border-[var(--color-primary)] focus:ring-0 focus:outline-none transition-all placeholder:text-[var(--color-text-tertiary)] resize-y" id="message" name="message" placeholder="Detail your requirements here..." required rows="5"></textarea>
            </div>

            <label class="flex items-start gap-3 text-xs text-[var(--color-text-secondary)] leading-relaxed cursor-pointer" for="consent">
              <input class="mt-0.5 w-4 h-4 rounded border-white/20 bg-[var(--color-surface-alt)] text-[var(--color-primary)] focus:ring-0 focus:ring-offset-0" id="consent" name="consent" required type="checkbox" />
              I agree to be contacted regarding this inquiry and consent to M2-Square storing my details for that purpose.
            </label>

            <div class="pt-4 flex flex-wrap items-center justify-between gap-4 border-t border-white/10">
              <div class="text-xs font-mono text-[var(--color-text-tertiary)] flex items-center gap-2">
                <span class="material-symbols-outlined text-[14px]">lock</span>Encrypted SSL connection
              </div>
              <button class="gold-btn text-white font-semibold px-6 py-3 rounded-xl transition-all duration-300 flex items-center justify-center gap-2 shadow-[0_0_15px_color-mix(in_srgb,var(--color-primary)_25%,transparent)] hover:shadow-[0_0_25px_color-mix(in_srgb,var(--color-primary)_50%,transparent)]" type="submit">
                <span class="tracking-widest uppercase text-xs">Submit Request</span>
                <span class="material-symbols-outlined text-[18px]">send</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-4 w-full flex flex-col gap-6">
        <!-- Direct lines -->
        <div class="pop-card bg-[var(--color-surface)]/70 border border-white/10 backdrop-blur-xl rounded-2xl p-6 shadow-2xl relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[var(--color-primary)]/50 to-transparent"></div>
          <h3 class="text-xl font-semibold text-[var(--color-text)] mb-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#3DD68C] animate-pulse"></span>
            Direct Lines
          </h3>
          <div class="flex flex-col gap-3">
            <a href="mailto:sales@m2-square.com" class="group flex items-center gap-3 p-3 rounded-xl bg-[var(--color-surface-alt)] border border-white/5 hover:border-[var(--color-primary)]/45 transition-all">
              <span class="material-symbols-outlined text-[var(--color-primary)]">mail</span>
              <div>
                <div class="text-[11px] text-[var(--color-text-secondary)] uppercase tracking-wider">Email</div>
                <div class="text-sm text-[var(--color-text)] group-hover:text-[var(--color-tertiary)] transition-colors">sales@m2-square.com</div>
              </div>
            </a>
            <a href="tel:+201553577554" class="group flex items-center gap-3 p-3 rounded-xl bg-[var(--color-surface-alt)] border border-white/5 hover:border-[var(--color-primary)]/45 transition-all">
              <span class="material-symbols-outlined text-[var(--color-primary)]">phone</span>
              <div>
                <div class="text-[11px] text-[var(--color-text-secondary)] uppercase tracking-wider">Phone</div>
                <div class="text-sm text-[var(--color-text)] group-hover:text-[var(--color-tertiary)] transition-colors">+20 155 357 7554</div>
              </div>
            </a>
            <a href="tel:+201551360527" class="group flex items-center gap-3 p-3 rounded-xl bg-[var(--color-surface-alt)] border border-white/5 hover:border-[var(--color-primary)]/45 transition-all">
              <span class="material-symbols-outlined text-[var(--color-primary)]">phone_in_talk</span>
              <div>
                <div class="text-[11px] text-[var(--color-text-secondary)] uppercase tracking-wider">Phone (Alt)</div>
                <div class="text-sm text-[var(--color-text)] group-hover:text-[var(--color-tertiary)] transition-colors">+20 155 136 0527</div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .ambient-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 50% 40% at 10% 5%, color-mix(in srgb, var(--color-primary) 16%, transparent) 0%, transparent 60%),
      radial-gradient(ellipse 45% 40% at 90% 10%, color-mix(in srgb, var(--color-secondary) 20%, transparent) 0%, transparent 60%),
      radial-gradient(ellipse 55% 45% at 85% 60%, color-mix(in srgb, var(--color-secondary) 7%, transparent) 0%, transparent 65%),
      radial-gradient(ellipse 55% 45% at 15% 85%, color-mix(in srgb, var(--color-tertiary) 6%, transparent) 0%, transparent 65%),
      radial-gradient(ellipse 60% 40% at 60% 100%, color-mix(in srgb, var(--color-secondary) 14%, transparent) 0%, transparent 65%);
  }

  .scroll-light {
    position: fixed;
    top: -30vh;
    left: 50%;
    width: 1600px;
    height: 1600px;
    margin-left: -800px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 11%, transparent) 0%, color-mix(in srgb, var(--color-primary) 3.5%, transparent) 40%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  /* Metallic gold heading accent — decorative text, not a button, so it keeps its gradient */
  .gold-text {
    color: transparent;
    background-clip: text;
    -webkit-background-clip: text;
    background-image: linear-gradient(100deg, var(--color-primary-hover) 0%, var(--color-primary) 40%, var(--color-tertiary) 65%, var(--color-primary) 100%);
  }

  /* Flat solid CTA button, matching the site's damped-down button style */
  .gold-btn {
    background-color: var(--color-primary);
  }
  .gold-btn:hover {
    background-color: var(--color-primary-hover);
  }

  .pop-card {
    opacity: 0;
    transform: translateY(40px) scale(0.92);
    transition: opacity 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275),
                transform 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    will-change: transform, opacity;
  }
  .pop-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .pop-card, .scroll-light, .animate-pulse {
      animation: none !important;
      transition: none !important;
    }
    .pop-card { opacity: 1; transform: none; }
    .scroll-light { transform: none !important; }
  }
</style>

<script>
  function setupScrollObserver() {
    const cards = Array.from(document.querySelectorAll('.pop-card:not(.is-visible)'));

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const cardIndex = cards.indexOf(entry.target as Element);
          setTimeout(() => {
            entry.target.classList.add('is-visible');
          }, (cardIndex % 4) * 120);
          observer.unobserve(entry.target);
        }
      });
    }, { root: null, threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    cards.forEach((card) => observer.observe(card));
  }

  function setupScrollLight() {
    const light = document.getElementById('scroll-light');
    if (!light) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const MAX_DRIFT = 260;
    const DRIFT_FACTOR = 0.12;
    let ticking = false;

    function update() {
      const y = Math.min(window.scrollY * DRIFT_FACTOR, MAX_DRIFT);
      light!.style.transform = `translate3d(0, ${y}px, 0)`;
      ticking = false;
    }
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupScrollObserver();
    setupScrollLight();
  });
  document.addEventListener('astro:page-load', () => {
    setupScrollObserver();
    setupScrollLight();
  });
</script>