---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us - M2-Square">
  <!-- Loads the icon font directly so the material-symbols-outlined spans below
       actually render as icons instead of printing their raw ligature names -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
  />

  <main class="pt-24 pb-24 relative overflow-x-hidden bg-black text-white">
    <!--
      GLOBAL AMBIENT BACKGROUND — replaces the old per-section blur blobs.

      Why: the previous version had ~12 separate `blur-[140-170px]` divs
      scattered through every section, plus a `.mesh-bg-about` layer that
      animated `background-position` across a 7-stop gradient the size of
      the whole page. `background-position` is a paint property, not a
      compositor one, so that animation was repainting a full-page gradient
      stack every frame — the single biggest source of the lag. The blur
      blobs were each their own expensive filter layer, and because they
      were pinned to individual sections, the color never actually blended
      between sections — it just visually "restarted" at each boundary.

      Fix: one `position: fixed` layer, mounted once, built from plain
      radial-gradients (no `filter: blur` — a radial-gradient is already
      soft, so blur was pure overhead here). Being fixed and singular means
      it's behind every section continuously, so there's no seam left to
      blend — same layer, no boundary. It never repaints on scroll since
      nothing about it changes; the browser just composites it once.
    -->
    <div class="ambient-bg" aria-hidden="true"></div>

    <!--
      SCROLL-FOLLOWING SPOTLIGHT
      Large-radius orange glow that stays with you as you scroll, instead
      of being trapped in one section. Fixed positioning already means it
      never leaves the viewport; the small scroll-linked drift on top of
      that is done by writing a single `transform: translate3d(...)` per
      animation frame (compositor-only — no layout, no paint), throttled
      with rAF and capped so it settles rather than racing off-screen.
    -->
    <div id="scroll-light" class="scroll-light" aria-hidden="true"></div>

    <!-- Ambient starfield — small glowing particles drifting slowly, spans the whole page -->
    <div class="bg-starfield absolute inset-0 pointer-events-none z-0" aria-hidden="true">
      <span class="star" style="top:4%; left:8%; --size:2px; --delay:0s; --dur:8s; --drift:16px; --tint:#ffb59a;"></span>
      <span class="star" style="top:9%; left:34%; --size:1.5px; --delay:1.2s; --dur:9s; --drift:10px; --tint:#ff6a2b;"></span>
      <span class="star" style="top:14%; left:62%; --size:2px; --delay:0.5s; --dur:7.5s; --drift:14px; --tint:#71d2ff;"></span>
      <span class="star" style="top:6%; left:88%; --size:2.5px; --delay:2s; --dur:10s; --drift:18px; --tint:#ffb59a;"></span>
      <span class="star" style="top:22%; left:18%; --size:1.5px; --delay:0.8s; --dur:8.5s; --drift:12px; --tint:#ff6a2b;"></span>
      <span class="star" style="top:26%; left:76%; --size:2px; --delay:1.6s; --dur:7s; --drift:16px; --tint:#ffffff;"></span>
      <span class="star" style="top:31%; left:46%; --size:2.5px; --delay:0.3s; --dur:9.5s; --drift:20px; --tint:#ff6a2b;"></span>
      <span class="star" style="top:36%; left:5%; --size:1.5px; --delay:2.4s; --dur:8s; --drift:10px; --tint:#71d2ff;"></span>
      <span class="star" style="top:40%; left:92%; --size:2px; --delay:1s; --dur:7.8s; --drift:14px; --tint:#ffb59a;"></span>
      <span class="star" style="top:45%; left:28%; --size:1.5px; --delay:1.8s; --dur:9s; --drift:12px; --tint:#ffffff;"></span>
      <span class="star" style="top:49%; left:60%; --size:2.5px; --delay:0.6s; --dur:8.2s; --drift:18px; --tint:#ff6a2b;"></span>
      <span class="star" style="top:53%; left:11%; --size:2px; --delay:2.2s; --dur:7.6s; --drift:14px; --tint:#71d2ff;"></span>
      <span class="star" style="top:57%; left:81%; --size:1.5px; --delay:0.9s; --dur:9.2s; --drift:10px; --tint:#ffb59a;"></span>
      <span class="star" style="top:61%; left:38%; --size:2px; --delay:1.4s; --dur:8s; --drift:16px; --tint:#ff6a2b;"></span>
      <span class="star" style="top:65%; left:66%; --size:2.5px; --delay:0.2s; --dur:9.6s; --drift:20px; --tint:#ffffff;"></span>
      <span class="star" style="top:69%; left:15%; --size:1.5px; --delay:2s; --dur:7.4s; --drift:12px; --tint:#71d2ff;"></span>
      <span class="star" style="top:73%; left:52%; --size:2px; --delay:1.1s; --dur:8.6s; --drift:14px; --tint:#ffb59a;"></span>
      <span class="star" style="top:77%; left:90%; --size:1.5px; --delay:0.4s; --dur:9.4s; --drift:10px; --tint:#ff6a2b;"></span>
      <span class="star" style="top:81%; left:24%; --size:2.5px; --delay:1.7s; --dur:8.4s; --drift:18px; --tint:#ffffff;"></span>
      <span class="star" style="top:85%; left:70%; --size:2px; --delay:0.7s; --dur:7.2s; --drift:14px; --tint:#71d2ff;"></span>
      <span class="star" style="top:89%; left:42%; --size:1.5px; --delay:2.3s; --dur:9.8s; --drift:12px; --tint:#ff6a2b;"></span>
      <span class="star" style="top:93%; left:8%; --size:2px; --delay:1.3s; --dur:8s; --drift:16px; --tint:#ffb59a;"></span>
      <span class="star" style="top:96%; left:58%; --size:2.5px; --delay:0.1s; --dur:9s; --drift:18px; --tint:#ff6a2b;"></span>
      <span class="star" style="top:18%; left:97%; --size:1.5px; --delay:1.9s; --dur:8.8s; --drift:10px; --tint:#ffffff;"></span>
      <span class="star" style="top:38%; left:97%; --size:2px; --delay:0.6s; --dur:7.6s; --drift:14px; --tint:#71d2ff;"></span>
      <span class="star" style="top:62%; left:2%; --size:2.5px; --delay:1.5s; --dur:9.2s; --drift:18px; --tint:#ffb59a;"></span>
      <span class="star" style="top:83%; left:3%; --size:1.5px; --delay:2.1s; --dur:8.4s; --drift:12px; --tint:#ff6a2b;"></span>
    </div>

    <!-- 1. HERO SECTION -->
    <section class="relative min-h-[75vh] flex flex-col items-center justify-center px-6 max-w-5xl mx-auto py-16 text-center z-10 perspective-1000">
      <div class="absolute top-1/3 left-1/2 w-[400px] sm:w-[500px] h-[400px] sm:h-[500px] bg-[radial-gradient(circle,_rgba(255,106,43,0.35)_0%,_rgba(255,106,43,0)_70%)] rounded-full pointer-events-none -z-10 animate-fast-breath"></div>

      <!-- Hero Badge -->
      <div class="pop-card inline-flex items-center gap-2 border border-white/10 bg-[#131316]/80 backdrop-blur-md px-4 py-1.5 rounded-full mb-8 shadow-md">
        <span class="w-2 h-2 rounded-full bg-[#ff6a2b] animate-pulse shadow-[0_0_8px_rgba(255,106,43,0.8)]"></span>
        <span class="font-mono text-xs text-[#A3A3AA] uppercase tracking-widest">Enterprise Resource Planning</span>
      </div>

      <!-- Animated Floating Logo -->
      <div class="mb-8 animate-zoom-in flex flex-col items-center justify-center w-full">
        <img
          src="/assets/Logo.png"
          alt="M-Square Logo"
          class="h-[280px] sm:h-[360px] md:h-[420px] w-auto object-contain max-w-none animate-logo-combined"
        />
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold text-[#F5F5F4] mb-6 leading-tight tracking-tight max-w-4xl">
        Precision in <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#ff6a2b] to-[#ffb59a] drop-shadow-[0_0_20px_rgba(255,106,43,0.3)]">Business Infrastructure</span>
      </h1>

      <!-- Hero Paragraph -->
      <div class="w-full max-w-2xl mx-auto px-4">
        <p class="text-base sm:text-xl text-[#E5E5E5] font-medium leading-relaxed text-center">
          We engineer ERP software that unifies finance, inventory, purchasing, sales, and customer data into a single connected system. Stripped of fluff, built on accounting-grade accuracy, and designed for zero-guesswork decision making.
        </p>
      </div>
    </section>

    <!-- 2. "WHO IS IT FOR?" CORE CARDS SECTION -->
    <section class="py-24 px-6 max-w-7xl mx-auto relative z-10 flex flex-col items-center">
      <div class="w-full max-w-2xl text-center mb-4 flex justify-center">
        <h2 class="text-3xl sm:text-5xl font-bold text-[#F5F5F4] whitespace-nowrap min-w-max">
          Who Is It For?
        </h2>
      </div>

      <div class="w-full max-w-2xl text-center mb-16 px-4">
        <p class="text-[#A3A3AA] text-base sm:text-lg leading-relaxed text-center block w-full min-w-[280px] sm:min-w-[500px]">
          Engineered for businesses that need every branch, warehouse, and ledger entry to agree with each other. Stripped of unnecessary complexity and built for absolute traceability.
        </p>
      </div>

      <!-- 3-Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 w-full perspective-1000">
        <div class="pop-card glow-card group relative p-10 rounded-3xl bg-[#131316]/60 border border-white/10 backdrop-blur-xl flex flex-col items-center text-center transition-all duration-300 hover:shadow-[0_10px_30px_rgba(255,106,43,0.2)]">
          <div class="w-24 h-24 mb-8 flex items-center justify-center rounded-2xl bg-[#1C1C20] border border-white/5 group-hover:scale-110 group-hover:bg-[#ff6a2b]/10 transition-all duration-300">
            <span class="material-symbols-outlined text-4xl text-[#A3A3AA] group-hover:text-[#ff6a2b]">account_balance</span>
          </div>
          <h3 class="text-2xl font-semibold text-[#F5F5F4] mb-4">Financial Integrity</h3>
          <p class="text-[#A3A3AA] leading-relaxed text-base">
            A full accounting engine built on a 4-level chart of accounts and balanced double-entry journals. We do not compromise on the numbers underneath the numbers.
          </p>
        </div>

        <div class="pop-card glow-card group relative p-10 rounded-3xl bg-[#131316]/60 border border-white/10 backdrop-blur-xl flex flex-col items-center text-center transition-all duration-300 hover:shadow-[0_10px_30px_rgba(255,106,43,0.2)]">
          <div class="w-24 h-24 mb-8 flex items-center justify-center rounded-2xl bg-[#1C1C20] border border-white/5 group-hover:scale-110 group-hover:bg-[#ff6a2b]/10 transition-all duration-300">
            <span class="material-symbols-outlined text-4xl text-[#A3A3AA] group-hover:text-[#ff6a2b]">inventory_2</span>
          </div>
          <h3 class="text-2xl font-semibold text-[#F5F5F4] mb-4">Real-Time Visibility</h3>
          <p class="text-[#A3A3AA] leading-relaxed text-base">
            Stock, branches, and warehouses stay in sync the moment a sale, purchase, or transfer happens — no end-of-day reconciliation required.
          </p>
        </div>

        <div class="pop-card glow-card group relative p-10 rounded-3xl bg-[#131316]/60 border border-white/10 backdrop-blur-xl flex flex-col items-center text-center transition-all duration-300 hover:shadow-[0_10px_30px_rgba(255,106,43,0.2)]">
          <div class="w-24 h-24 mb-8 flex items-center justify-center rounded-2xl bg-[#1C1C20] border border-white/5 group-hover:scale-110 group-hover:bg-[#ff6a2b]/10 transition-all duration-300">
            <span class="material-symbols-outlined text-4xl text-[#A3A3AA] group-hover:text-[#ff6a2b]">fact_check</span>
          </div>
          <h3 class="text-2xl font-semibold text-[#F5F5F4] mb-4">Built-In Accountability</h3>
          <p class="text-[#A3A3AA] leading-relaxed text-base">
            Every entry, return, and transfer leaves a trail. Unbalanced-entry detection and full audit reports catch discrepancies before they become problems.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. INTERACTIVE ORBITAL NETWORK VISUAL SECTION (Module Ecosystem) -->
    <section class="orbit-section py-28 md:py-36 px-6 relative z-10 flex flex-col items-center">
      <div class="w-full max-w-2xl text-center mb-12 md:mb-16">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[#F5F5F4] mb-4">
          One Core. Every Department.
        </h2>
        <p class="text-[#A3A3AA] text-base sm:text-lg">
          Every module reads and writes to the same core — a sale updates inventory, a purchase updates accounts, automatically.
        </p>
      </div>

      <div class="orbit-track w-full max-w-6xl mx-auto h-[520px] sm:h-[600px] md:h-[680px] lg:h-[760px] relative flex items-center justify-center overflow-hidden">
        <!-- Ambient pulsing glow field behind everything -->
        <div class="orbit-bg-glow"></div>

        <!-- Slowly rotating conic "energy field" -->
        <div class="orbit-conic-field"></div>

        <!-- Twinkling particle field -->
        <div class="orbit-particles" aria-hidden="true">
          <span class="particle" style="top:10%; left:18%; --size:3px; --delay:0s; --dur:4.5s;"></span>
          <span class="particle" style="top:16%; left:72%; --size:2px; --delay:1.1s; --dur:5.2s;"></span>
          <span class="particle" style="top:28%; left:45%; --size:2px; --delay:2s; --dur:4s;"></span>
          <span class="particle" style="top:34%; left:88%; --size:3px; --delay:0.6s; --dur:5.8s;"></span>
          <span class="particle" style="top:42%; left:8%; --size:2px; --delay:2.6s; --dur:4.6s;"></span>
          <span class="particle" style="top:55%; left:30%; --size:3px; --delay:1.6s; --dur:5s;"></span>
          <span class="particle" style="top:60%; left:78%; --size:2px; --delay:0.3s; --dur:4.2s;"></span>
          <span class="particle" style="top:68%; left:55%; --size:2px; --delay:2.2s; --dur:5.4s;"></span>
          <span class="particle" style="top:74%; left:15%; --size:3px; --delay:1.4s; --dur:4.8s;"></span>
          <span class="particle" style="top:80%; left:65%; --size:2px; --delay:0.9s; --dur:5.6s;"></span>
          <span class="particle" style="top:20%; left:60%; --size:2px; --delay:1.8s; --dur:4.4s;"></span>
          <span class="particle" style="top:88%; left:38%; --size:3px; --delay:2.4s; --dur:5.1s;"></span>
        </div>

        <!-- Concentric Radial Orbit Lines -->
        <div class="absolute rounded-full border border-white/10 animate-spin-slow w-[460px] h-[460px] sm:w-[520px] sm:h-[520px] md:w-[600px] md:h-[600px] lg:w-[680px] lg:h-[680px]"></div>
        <div class="absolute rounded-full border border-white/5 animate-spin-reverse w-[680px] h-[680px] sm:w-[780px] sm:h-[780px] md:w-[880px] md:h-[880px] lg:w-[1000px] lg:h-[1000px]"></div>
        <div class="absolute rounded-full border border-white/[0.02] w-[780px] h-[780px] sm:w-[880px] sm:h-[880px] md:w-[1000px] md:h-[1000px] lg:w-[1150px] lg:h-[1150px]"></div>

        <!-- Central Illuminated Node — animated, recolored logo -->
        <div class="core-hub z-10 relative flex flex-col items-center justify-center text-center">
          <div class="core-logo-frame">
            <div class="core-logo-glow"></div>
            <div class="core-hub-ring"></div>
            <div class="core-hub-ring core-hub-ring-2"></div>
            <img src="/assets/Logo.png" alt="M2 ERP Core" class="core-logo-img" />
          </div>
          <span class="font-mono text-[10px] sm:text-xs md:text-sm text-[#ff6a2b] uppercase tracking-widest block font-bold mt-4">M2 ERP Core</span>
        </div>

        <!-- Orbiting Satellites — Inner Ring (spins with the innermost line) -->
        <div class="orbit-ring-item orbit-inner" style="--duration:42s; --delay:0s; --dir:1;">
          <div class="orbit-card">
            <div class="pop-card is-visible whitespace-nowrap p-2.5 sm:p-3 md:p-4 lg:p-5 rounded-xl bg-[#131316]/80 border border-white/10 backdrop-blur-md flex items-center gap-2 sm:gap-3 shadow-lg shadow-black/30">
              <span class="material-symbols-outlined text-[#ff6a2b] text-base sm:text-lg md:text-xl lg:text-2xl">account_balance</span>
              <span class="text-[9px] sm:text-[10px] md:text-xs lg:text-sm font-mono text-[#E5E5E5]">General Ledger</span>
            </div>
          </div>
        </div>
        <div class="orbit-ring-item orbit-inner" style="--duration:42s; --delay:-14s; --dir:1;">
          <div class="orbit-card">
            <div class="pop-card is-visible whitespace-nowrap p-2.5 sm:p-3 md:p-4 lg:p-5 rounded-xl bg-[#131316]/80 border border-white/10 backdrop-blur-md flex items-center gap-2 sm:gap-3 shadow-lg shadow-black/30">
              <span class="material-symbols-outlined text-[#ff6a2b] text-base sm:text-lg md:text-xl lg:text-2xl">inventory_2</span>
              <span class="text-[9px] sm:text-[10px] md:text-xs lg:text-sm font-mono text-[#E5E5E5]">Inventory</span>
            </div>
          </div>
        </div>
        <div class="orbit-ring-item orbit-inner" style="--duration:42s; --delay:-28s; --dir:1;">
          <div class="orbit-card">
            <div class="pop-card is-visible whitespace-nowrap p-2.5 sm:p-3 md:p-4 lg:p-5 rounded-xl bg-[#131316]/80 border border-white/10 backdrop-blur-md flex items-center gap-2 sm:gap-3 shadow-lg shadow-black/30">
              <span class="material-symbols-outlined text-[#ff6a2b] text-base sm:text-lg md:text-xl lg:text-2xl">groups</span>
              <span class="text-[9px] sm:text-[10px] md:text-xs lg:text-sm font-mono text-[#E5E5E5]">Human Resources</span>
            </div>
          </div>
        </div>

        <!-- Orbiting Satellites — Outer Ring (spins opposite direction) -->
        <div class="orbit-ring-item orbit-outer" style="--duration:60s; --delay:0s; --dir:-1;">
          <div class="orbit-card">
            <div class="pop-card is-visible whitespace-nowrap p-2.5 sm:p-3 md:p-4 lg:p-5 rounded-xl bg-[#131316]/80 border border-white/10 backdrop-blur-md flex items-center gap-2 sm:gap-3 shadow-lg shadow-black/30">
              <span class="material-symbols-outlined text-[#ff6a2b] text-base sm:text-lg md:text-xl lg:text-2xl">shopping_cart</span>
              <span class="text-[9px] sm:text-[10px] md:text-xs lg:text-sm font-mono text-[#E5E5E5]">Purchasing</span>
            </div>
          </div>
        </div>
        <div class="orbit-ring-item orbit-outer" style="--duration:60s; --delay:-20s; --dir:-1;">
          <div class="orbit-card">
            <div class="pop-card is-visible whitespace-nowrap p-2.5 sm:p-3 md:p-4 lg:p-5 rounded-xl bg-[#131316]/80 border border-white/10 backdrop-blur-md flex items-center gap-2 sm:gap-3 shadow-lg shadow-black/30">
              <span class="material-symbols-outlined text-[#ff6a2b] text-base sm:text-lg md:text-xl lg:text-2xl">point_of_sale</span>
              <span class="text-[9px] sm:text-[10px] md:text-xs lg:text-sm font-mono text-[#E5E5E5]">Sales</span>
            </div>
          </div>
        </div>
        <div class="orbit-ring-item orbit-outer" style="--duration:60s; --delay:-40s; --dir:-1;">
          <div class="orbit-card">
            <div class="pop-card is-visible whitespace-nowrap p-2.5 sm:p-3 md:p-4 lg:p-5 rounded-xl bg-[#131316]/80 border border-white/10 backdrop-blur-md flex items-center gap-2 sm:gap-3 shadow-lg shadow-black/30">
              <span class="material-symbols-outlined text-[#ff6a2b] text-base sm:text-lg md:text-xl lg:text-2xl">support_agent</span>
              <span class="text-[9px] sm:text-[10px] md:text-xs lg:text-sm font-mono text-[#E5E5E5]">Customer Service</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. FEATURE CAPABILITIES GRID (2-COL) -->
    <section class="py-24 px-6 max-w-7xl mx-auto relative z-10 overflow-hidden">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-5xl font-bold text-[#F5F5F4] mb-4">Inside the Platform</h2>
        <p class="text-[#A3A3AA] text-base sm:text-lg max-w-2xl mx-auto">
          Every module is built the way businesses actually operate — layered, structured, and detail-obsessed.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 perspective-1000">
        <div class="pop-card glow-card relative p-10 rounded-3xl bg-[#131316]/40 border border-white/10 transition-all flex gap-6">
          <div class="p-5 bg-[#1C1C20] rounded-2xl border border-white/5 h-fit text-[#ff6a2b]">
            <span class="material-symbols-outlined text-4xl">account_balance_wallet</span>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white mb-3">General Ledger & Accounting</h3>
            <p class="text-[#A3A3AA] text-base leading-relaxed">
              Banks, treasuries, and branch accounts sit on top of a 4-level chart of accounts. Daily journal entries roll straight into trial balances, financial statements, and an unbalanced-entries report — every one exportable to Excel.
            </p>
          </div>
        </div>

        <div class="pop-card glow-card relative p-10 rounded-3xl bg-[#131316]/40 border border-white/10 transition-all flex gap-6">
          <div class="p-5 bg-[#1C1C20] rounded-2xl border border-white/5 h-fit text-[#ff6a2b]">
            <span class="material-symbols-outlined text-4xl">warehouse</span>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white mb-3">Inventory & Warehouse Management</h3>
            <p class="text-[#A3A3AA] text-base leading-relaxed">
              Departments, groups, and item cards track live balances, min/max thresholds, and cost across unlimited branches. Addition, deduction, and transfer notes keep every stock movement logged and traceable.
            </p>
          </div>
        </div>

        <div class="pop-card glow-card relative p-10 rounded-3xl bg-[#131316]/40 border border-white/10 transition-all flex gap-6">
          <div class="p-5 bg-[#1C1C20] rounded-2xl border border-white/5 h-fit text-[#ff6a2b]">
            <span class="material-symbols-outlined text-4xl">local_shipping</span>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white mb-3">Purchasing & Vendor Management</h3>
            <p class="text-[#A3A3AA] text-base leading-relaxed">
