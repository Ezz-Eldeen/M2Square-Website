<!-- Queued Stagger Animation Script + scroll-linked spotlight -->
<script>
  function setupScrollObserver() {
    const cards = Array.from(document.querySelectorAll('.pop-card'));

    const observerOptions = {
      root: null,
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const cardIndex = cards.indexOf(entry.target);

          // Queue entrance: delay each card by 150ms sequentially
          setTimeout(() => {
            entry.target.classList.add('is-visible');
          }, (cardIndex % 4) * 150);

          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    cards.forEach((card) => observer.observe(card));
  }

  // Scroll-following spotlight: writes a single transform per animation
  // frame, throttled to the frame rate via requestAnimationFrame and
  // capped so the light settles into place instead of chasing scroll
  // position indefinitely. transform is compositor-only — this never
  // triggers layout or paint, so it stays cheap no matter how long the
  // page is.
  function setupScrollLight() {
    const light = document.getElementById('scroll-light');
    if (!light) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    const MAX_DRIFT = 260; // px — how far the light is allowed to drift down
    const DRIFT_FACTOR = 0.12; // fraction of scroll distance it follows
    let ticking = false;

    function update() {
      const y = Math.min(window.scrollY * DRIFT_FACTOR, MAX_DRIFT);
      light.style.transform = `translate3d(0, ${y}px, 0)`;
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupScrollObserver();
    setupScrollLight();
  });
  document.addEventListener('astro:page-load', () => {
    setupScrollObserver();
    setupScrollLight();
  });
</script>