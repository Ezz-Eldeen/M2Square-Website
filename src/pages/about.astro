---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoImg from '../assets/Logo.png';
---

<Layout
  title="About Us - M2-Square"
  description="Founded in 2021 by two IT veterans with 60+ years of combined experience, M-Square delivers ERP, e-tax compliance, web and infrastructure solutions in Egypt."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Sora:wght@600;700&display=swap"
  />

  <main class="about-page">
    <div class="ambient" aria-hidden="true"></div>

    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-mark">
          <div class="mark-frame">
            <div class="mark-glow" aria-hidden="true"></div>
            <Image
              src={logoImg}
              alt="M-Square"
              class="mark-logo"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>

        <div class="hero-copy">
          <span class="eyebrow">
            <span class="status-dot" aria-hidden="true"></span>
            Founded 2021
          </span>

          <h1>We build the infrastructure businesses run on.</h1>

          <p class="lede">
            M-Square was co-founded by Mr. Mohamed El-Fiky and Mr. Mohamed
            Khamis, who bring a combined experience of 60+ years in the
            field of IT and business administration.
          </p>

          <p>
            In 2021, they recognized the need for a modern, frictionless
            solution for the new electronic invoice system introduced by
            the Egyptian Tax Authority. They gathered a team of experts to
            develop a comprehensive solution that streamlined the
            invoicing process and ensured compliance with the latest
            regulations. The project was a major success, and clients were
            highly satisfied with the results — leading the company to
            expand into customized ERP solutions and other software
            solutions, like websites, for highly reputable clients.
          </p>

          <dl class="fact-row">
            <div class="fact">
              <dt>Founded</dt>
              <dd>2021</dd>
            </div>
            <div class="fact">
              <dt>Combined experience</dt>
              <dd>60+ years</dd>
            </div>
            <div class="fact">
              <dt>Co-founders</dt>
              <dd>2</dd>
            </div>
            <div class="fact">
              <dt>What we build</dt>
              <dd>ERP &amp; web</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Compact Bento Section (Vision, Mission, Values & Capabilities) -->
    <section class="bento-section">
      <div class="bento-grid">
        
        <!-- Vision Card -->
        <div class="bento-card vision-card">
          <h2>Our Vision</h2>
          <p>
            To be the trusted digital backbone of ambitious businesses across Egypt and the
            region — the partner organizations turn to when they need their operations,
            compliance, and technology to work as one seamless system.
          </p>
        </div>

        <!-- Mission Card -->
        <div class="bento-card mission-card">
          <h2>Our Mission</h2>
          <p>
            To design, build, and support intelligent, AI-driven software and
            infrastructure — from ERP and e-tax compliance to websites, mobile apps, and
            secure networks — that simplify how our clients operate, keep them fully
            compliant, and give them the technical foundation to scale with confidence.
          </p>
        </div>

        <!-- Core Values Header / Span Card -->
        <div class="bento-card values-header-card">
          <h2>Our Core Values</h2>
          <p>The principles driving our engineering and client partnerships.</p>
        </div>

        <!-- Values List Cards -->
        <div class="bento-card value-item">
          <h3>Innovation with Purpose</h3>
          <p>Adopting AI and automation where it genuinely improves outcomes.</p>
        </div>

        <div class="bento-card value-item">
          <h3>True Partnership</h3>
          <p>Working embedded directly with your team, not at arm's length.</p>
        </div>

        <div class="bento-card value-item">
          <h3>Integrity</h3>
          <p>Transparent timelines, honest scoping, and total accountability.</p>
        </div>

        <div class="bento-card value-item">
          <h3>Precision & Reliability</h3>
          <p>Systems built to run without surprises, backed by rigorous support.</p>
        </div>

        <div class="bento-card value-item">
          <h3>Compliance-First</h3>
          <p>Staying ahead of regulatory change so you never have to worry.</p>
        </div>

        <!-- What We Build Strip -->
        <div class="bento-card build-strip">
          <h2>What We Build</h2>
          <span class="build-tags">ERP &bull; E-Taxes &bull; Web &bull; Mobile &bull; Infrastructure</span>
        </div>

      </div>
    </section>

  </main>
</Layout>

<style>
  .about-page {
    --bg: #0d0d0e;
    --panel: #17161a;
    --border: rgba(255, 255, 255, 0.09);
    --text-primary: #f5f3ef;
    --text-secondary: #b4b2ad;
    --text-tertiary: #817f7b;
    --accent: #ff6a2b;
    --accent-soft: #ffb59a;

    position: relative;
    overflow-x: hidden;
    background: var(--bg);
    color: var(--text-primary);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    padding-block: clamp(3rem, 6vw, 6rem);
  }

  .ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 50% 40% at 20% 0%, rgba(255, 106, 43, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse 55% 45% at 85% 65%, rgba(255, 181, 154, 0.05) 0%, transparent 65%);
  }

  .hero, .bento-section {
    position: relative;
    z-index: 1;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .bento-section {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: 'mark' 'copy';
    align-items: center;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.75fr);
      grid-template-areas: 'copy mark';
      gap: clamp(3rem, 6vw, 5rem);
    }
  }

  /* ---- Copy column ---- */

  .hero-copy {
    grid-area: copy;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--panel);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: rise 0.6s ease-out forwards;
    animation-delay: 0.1s;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulseDot 3s ease-in-out infinite;
  }

  h1 {
    font-family: 'Sora', 'IBM Plex Sans', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0 0 1.25rem;
    max-width: 18ch;
    opacity: 0;
    animation: rise 0.6s ease-out forwards;
    animation-delay: 0.2s;
  }

  .hero-copy p {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 52ch;
    margin: 0 0 1rem;
    opacity: 0;
    animation: rise 0.6s ease-out forwards;
  }

  .hero-copy p.lede {
    color: var(--text-primary);
    font-size: 1.125rem;
    animation-delay: 0.3s;
  }

  .hero-copy p:not(.lede) {
    animation-delay: 0.4s;
  }

  .fact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 2rem 0 0;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    opacity: 0;
    animation: rise 0.6s ease-out forwards;
    animation-delay: 0.5s;
  }

  .fact {
    flex: 1 1 7rem;
    padding-right: 1.5rem;
    margin-right: 1.5rem;
    border-right: 1px solid var(--border);
  }

  .fact:last-child {
    border-right: none;
    margin-right: 0;
    padding-right: 0;
  }

  .fact dt {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin: 0 0 0.35rem;
  }

  .fact dd {
    font-family: 'Sora', 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    position: relative;
    padding-top: 0.5rem;
  }

  .fact dd::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1.25rem;
    height: 2px;
    background: var(--accent);
  }

  /* ---- Mark / logo column ---- */

  .hero-mark {
    grid-area: mark;
    display: flex;
    justify-content: center;
  }

  .mark-frame {
    position: relative;
    width: clamp(300px, 36vw, 440px);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: zoomInFade 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .mark-glow {
    position: absolute;
    inset: -30%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 106, 43, 0.35) 0%, rgba(255, 106, 43, 0) 70%);
    animation: fastBreath 2.5s ease-in-out infinite;
  }

  .mark-logo {
    position: relative;
    width: 86%;
    height: auto;
    object-fit: contain;
    animation: logoCombined 3s ease-in-out infinite;
  }

  /* ---- Bento Grid Layout (Low Scroll & High Visual Appeal) ---- */

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bento-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.75rem;
    position: relative;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .bento-card:hover {
    border-color: rgba(255, 106, 43, 0.4);
    transform: translateY(-2px);
  }

  /* Spanning rules for Bento layout */
  .vision-card, .mission-card {
    grid-column: span 1;
  }
  @media (min-width: 768px) {
    .vision-card, .mission-card {
      grid-column: span 1;
    }
  }
  @media (min-width: 1024px) {
    .vision-card, .mission-card {
      grid-column: span 1.5;
    }
  }

  .values-header-card {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, rgba(255, 106, 43, 0.08) 0%, var(--panel) 100%);
  }

  .build-strip {
    grid-column: 1 / -1;
    text-align: center;
    background: linear-gradient(135deg, rgba(255, 106, 43, 0.12) 0%, var(--panel) 100%);
    border: 1px solid rgba(255, 106, 43, 0.25);
    padding: 1.5rem;
  }

  .bento-card h2 {
    font-family: 'Sora', 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }

  .values-header-card h2 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .bento-card h3 {
    font-family: 'Sora', 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.4rem;
  }

  .bento-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .build-tags {
    display: inline-block;
    color: var(--accent-soft);
    font-size: 1.1rem;
    font-weight: 500;
    margin-top: 0.35rem;
    letter-spacing: 0.02em;
  }

  /* ---- Motion ---- */

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes zoomInFade {
    0% { opacity: 0; transform: scale(0.6); }
    100% { opacity: 1; transform: scale(1); }
  }

  @keyframes fastBreath {
    0%, 100% { transform: translate(0, 0) scale(0.85); opacity: 0.4; }
    50% { transform: translate(0, 0) scale(1.35); opacity: 0.85; }
  }

  @keyframes logoCombined {
    0%, 100% { filter: drop-shadow(0 0 35px rgba(255, 106, 43, 0.3)); transform: translateY(0px); }
    50% { filter: drop-shadow(0 0 75px rgba(255, 106, 43, 0.75)); transform: translateY(-14px); }
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .eyebrow, h1, .hero-copy p, .fact-row, .mark-frame {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .status-dot, .mark-glow, .mark-logo {
      animation: none !important;
    }
  }
</style>