---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoImg from '../assets/Logo.png';
---

<Layout
  title="About Us - M-Square | Enterprise Software Solutions"
  description="Learn about M-Square. We build the infrastructure businesses run on, from custom ERP platforms and e-taxes to web, mobile, and secure IT infrastructure."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Sora:wght@600;700&display=swap"
  />

  <main class="about-page">
    <div class="ambient" aria-hidden="true"></div>
    
    <!-- Hero Section -->
    <section class="section hero-section">
      <div class="container hero-container">
        <div class="hero-content hero-copy">
          <div class="eyebrow">
            <span class="status-dot"></span>
            <span>About M-Square</span>
          </div>
          <h1>We build the infrastructure businesses run on.</h1>
          <p class="lede">
            Enterprise software solutions, precision-engineered for performance, security, and absolute compliance.
          </p>
        </div>
        
        <!-- Trust Metrics / Stats Row -->
        <div class="stats-row fact-row">
          <div class="stat-item fact">
            <dt>Experience</dt>
            <dd>5+</dd>
          </div>
          <div class="stat-item fact">
            <dt>Focus</dt>
            <dd>100%</dd>
          </div>
          <div class="stat-item fact">
            <dt>Support</dt>
            <dd>24/7</dd>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Story Section -->
    <section class="section who-we-are-section">
      <div class="container split-layout">
        <div class="image-box hero-mark">
          <div class="logo-wrapper">
             <div class="mark-glow"></div>
             <Image src={logoImg} alt="M-Square Logo" class="floating-logo mark-logo" />
             <div class="glow-effect"></div>
          </div>
        </div>
        <div class="text-box">
          <h2>Our Story</h2>
          <p>
            In 2021, our founders identified a critical gap: businesses across Egypt needed a modern, frictionless way to comply with the newly introduced electronic invoicing system from the Egyptian Tax Authority (ETA). 
          </p>
          <p>
            They assembled a team of specialists and built a solution that streamlined invoicing and guaranteed full regulatory compliance from day one. That project's success became the foundation for something larger — today, M-Square has grown into a full-spectrum digital partner, delivering custom ERP platforms, high-performance websites and mobile apps, and secure IT infrastructure for some of the region's most reputable organizations.
          </p>
        </div>
      </div>
    </section>

    <!-- Vision & Mission Section -->
    <section class="section vision-mission-section">
      <div class="container">
        <div class="grid-2">
          <div class="card vm-card vision-card">
            <div class="icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            </div>
            <h3>Our Vision</h3>
            <p>
              To be the trusted digital backbone of ambitious businesses across Egypt and the region — the partner organizations turn to when they need their operations, compliance, and technology to work as one seamless system.
            </p>
          </div>
          <div class="card vm-card mission-card">
            <div class="icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Our Mission</h3>
            <p>
              To design, build, and support intelligent, AI-driven software and infrastructure — from ERP and e-tax compliance to websites, mobile apps, and secure networks — that simplify how our clients operate, keep them fully compliant, and give them the technical foundation to scale with confidence.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Values Section -->
    <section class="section values-section">
      <div class="container">
        <div class="section-header center">
          <h2>Our Core Values</h2>
        </div>
        
        <div class="grid-3 values-grid">
          <div class="value-item">
            <h4>Innovation with Purpose</h4>
            <p>Adopting AI and automation where it genuinely improves outcomes, not for its own sake.</p>
          </div>
          <div class="value-item">
            <h4>True Partnership</h4>
            <p>We work embedded with your team, not at arm's length.</p>
          </div>
          <div class="value-item">
            <h4>Integrity</h4>
            <p>Transparent timelines, honest scoping, and accountability at every stage.</p>
          </div>
          <div class="value-item">
            <h4>Precision & Reliability</h4>
            <p>Systems built to run without surprises, backed by rigorous testing and support.</p>
          </div>
          <div class="value-item">
            <h4>Compliance-First Thinking</h4>
            <p>Staying ahead of regulatory change so our clients never have to worry about it.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Capabilities / What We Build CTA -->
    <section class="section capabilities-section">
      <div class="container">
        <div class="cta-box build-strip">
          <h2>What We Build</h2>
          <div class="tags-wrapper">
            <span class="tech-tag">ERP</span>
            <span class="tech-tag">E-Taxes</span>
            <span class="tech-tag">Web</span>
            <span class="tech-tag">Mobile</span>
            <span class="tech-tag">Infrastructure</span>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
.about-page {
    /* M-Square brand: Blue #076CC7 · Gold #D29D52 · Midnight Navy #03111F */
    --bg: #03111F;
    --panel: #061a2e;
    --border: rgba(255, 255, 255, 0.09);
    --text-primary: #f5f7fa;
    --text-secondary: #a9bbcd;
    --text-tertiary: #7189a1;
    --accent: #D29D52;
    --accent-soft: #F6C973;
    --blue: #076CC7;
    --blue-light: #3BAAEF;
    --gold-metal: linear-gradient(100deg, #664725 0%, #D29D52 40%, #F6C973 65%, #D29D52 100%);

    background-color: var(--bg);
    color: var(--text-primary);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
    position: relative;
}

.ambient {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 50% 40% at 20% 0%, rgba(210, 157, 82, 0.12) 0%, transparent 60%),
    radial-gradient(ellipse 55% 45% at 85% 65%, rgba(7, 108, 199, 0.16) 0%, transparent 65%);
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
  position: relative;
  z-index: 1;
}

.section {
  padding: 5rem 0;
}

.section-header.center {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 3.5rem;
}

.section-header h2 {
  font-size: 2.25rem;
  margin-bottom: 1.0rem;
}

/* --- Hero Section --- */
.hero-section {
  padding-top: 8rem;
  padding-bottom: 4rem;
}

.hero-content {
  text-align: center;
  max-width: 900px;
  margin: 0 auto 4rem;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.4rem 0.85rem;
  border: 1px solid rgba(210, 157, 82, 0.3);
  border-radius: 999px;
  background: var(--panel);
  font-size: 0.8125rem;
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  animation: pulseDot 3s ease-in-out infinite;
}

h1 {
  font-family: 'Sora', 'IBM Plex Sans', system-ui, sans-serif;
  font-weight: 600;
  font-size: clamp(2.5rem, 5vw, 4rem);
  line-height: 1.2;
  margin-bottom: 1.5rem;
  letter-spacing: -0.02em;
  color: var(--text-primary);
}

.hero-copy p {
  font-size: 1.0625rem;
  line-height: 1.65;
  color: var(--text-secondary);
  max-width: 52ch;
  margin: 0 auto 1rem;
}

.hero-copy p.lede {
  color: var(--text-primary);
  font-size: 1.125rem;
}

.stats-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 2rem;
  padding-top: 3rem;
  border-top: 1px solid var(--border);
}

.fact {
  flex: 1 1 200px;
  text-align: center;
  padding-right: 0;
  margin-right: 0;
  border-right: none;
}

.fact dt {
  font-size: 0.8125rem;
  color: var(--text-tertiary);
  margin: 0 0 0.35rem;
}

.fact dd {
  font-family: 'Sora', 'IBM Plex Sans', system-ui, sans-serif;
  font-size: 3rem;
  font-weight: 700;
  color: var(--accent);
  margin: 0;
  line-height: 1;
}

/* --- Our Story Section --- */
.who-we-are-section {
  background-color: var(--panel);
}

.split-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 4rem;
  align-items: center;
}

@media (min-width: 992px) {
  .split-layout {
    grid-template-columns: 1fr 1fr;
  }
}

.hero-mark {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 3rem;
}

.mark-glow {
  position: absolute;
  inset: -30%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(210, 157, 82, 0.32) 0%, rgba(7, 108, 199, 0.12) 45%, rgba(7, 108, 199, 0) 70%);
  animation: fastBreath 2.5s ease-in-out infinite;
}

.mark-logo {
  position: relative;
  width: 250px;
  height: 250px;
}

.glow-effect {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  background: var(--accent);
  filter: blur(100px);
  opacity: 0.2;
  z-index: 0;
}

.floating-logo {
  position: relative;
  z-index: 1;
  width: 100%;
  height: auto;
  animation: float 6s ease-in-out infinite;
}

.text-box h2 {
  font-family: 'Sora', 'IBM Plex Sans', system-ui, sans-serif;
  font-size: 2.5rem;
  margin-bottom: 1.5rem;
  color: var(--text-primary);
}

.text-box p {
  color: var(--text-secondary);
  margin-bottom: 1.25rem;
  font-size: 1.05rem;
}

/* --- Vision & Mission Section --- */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}

@media (min-width: 768px) {
  .grid-2 {
    grid-template-columns: 1fr 1fr;
  }
}

.vm-card {
  background: var(--panel);
  border: 1px solid var(--border);
  padding: 3rem;
  border-radius: 1rem;
  transition: transform 0.3s ease;
}

.vm-card:hover {
  transform: translateY(-5px);
  border-color: rgba(210, 157, 82, 0.45);
}

.icon-wrapper {
  width: 60px;
  height: 60px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  margin-bottom: 1.5rem;
}

.vm-card h3 {
  font-family: 'Sora', 'IBM Plex Sans', system-ui, sans-serif;
  font-size: 1.75rem;
  margin-bottom: 1rem;
  color: var(--text-primary);
}

.vm-card p {
  color: var(--text-secondary);
}

/* --- Values Section --- */
.values-section {
  background-color: var(--panel);
}

.grid-3 {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

@media (min-width: 768px) {
  .grid-3 {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }
}

.value-item {
  background: var(--bg);
  padding: 2rem;
  border-radius: 0.75rem;
  border: 1px solid var(--border);
  border-top: 3px solid var(--accent);
}

.value-item h4 {
  font-family: 'Sora', 'IBM Plex Sans', system-ui, sans-serif;
  font-size: 1.25rem;
  margin-bottom: 0.75rem;
  color: var(--text-primary);
  margin-top: 0;
}

.value-item p {
  color: var(--text-secondary);
  font-size: 0.95rem;
  margin: 0;
}

/* --- Capabilities Section --- */
.capabilities-section {
  padding-bottom: 8rem;
}

.cta-box {
  background: linear-gradient(145deg, var(--panel) 0%, var(--bg) 100%);
  border: 1px solid var(--border);
  border-radius: 1.5rem;
  padding: 4rem 2rem;
  text-align: center;
}

.cta-box h2 {
  font-family: 'Sora', 'IBM Plex Sans', system-ui, sans-serif;
  font-size: 2.25rem;
  margin-bottom: 2.5rem;
  color: var(--text-primary);
}

.tags-wrapper {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
}

.tech-tag {
  background: var(--bg);
  border: 1px solid rgba(210, 157, 82, 0.3);
  color: var(--text-primary);
  padding: 0.75rem 1.5rem;
  border-radius: 50px;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tech-tag:hover {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}

/* --- Animations --- */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}

@keyframes fastBreath {
  0%, 100% { transform: translate(0, 0) scale(0.85); opacity: 0.4; }
  50% { transform: translate(0, 0) scale(1.35); opacity: 0.85; }
}

@keyframes pulseDot {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .floating-logo, .mark-glow {
    animation: none;
  }
}
</style>