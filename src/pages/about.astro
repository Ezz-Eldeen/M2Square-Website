---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoImg from '../assets/Logo.png';
---

<Layout
  title="About Us - M-Square | Enterprise Software Solutions"
  description="Learn about M-Square. We build the infrastructure businesses run on, from custom ERP platforms and e-taxes to web, mobile, and secure IT infrastructure."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Sora:wght@600;700&display=swap"
  />

  <main class="about-page">
    
    <!-- Hero Section -->
    <section class="section hero-section">
      <div class="container hero-container">
        <div class="hero-content">
          <span class="badge">About M-Square</span>
          <h1>We build the infrastructure businesses run on.</h1>
        </div>
        
        <!-- Trust Metrics / Stats Row -->
        <div class="stats-row">
          <div class="stat-item">
            <span class="stat-number">5+</span>
            <span class="stat-label">Years of Excellence</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">50+</span>
            <span class="stat-label">Enterprise Clients</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">100%</span>
            <span class="stat-label">Compliance Focus</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">24/7</span>
            <span class="stat-label">Dedicated Support</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Story Section -->
    <section class="section who-we-are-section">
      <div class="container split-layout">
        <div class="image-box">
          <div class="logo-wrapper">
             <Image src={logoImg} alt="M-Square Logo" class="floating-logo" />
             <div class="glow-effect"></div>
          </div>
        </div>
        <div class="text-box">
          <h2>Our Story</h2>
          <p>
            In 2021, our founders identified a critical gap: businesses across Egypt needed a modern, frictionless way to comply with the newly introduced electronic invoicing system from the Egyptian Tax Authority (ETA). 
          </p>
          <p>
            They assembled a team of specialists and built a solution that streamlined invoicing and guaranteed full regulatory compliance from day one. That project's success became the foundation for something larger — today, M-Square has grown into a full-spectrum digital partner, delivering custom ERP platforms, high-performance websites and mobile apps, and secure IT infrastructure for some of the region's most reputable organizations.
          </p>
        </div>
      </div>
    </section>

    <!-- Vision & Mission Section -->
    <section class="section vision-mission-section">
      <div class="container">
        <div class="grid-2">
          <div class="card vm-card">
            <div class="icon-wrapper">
              <!-- Vision Icon SVG -->
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            </div>
            <h3>Our Vision</h3>
            <p>
              To be the trusted digital backbone of ambitious businesses across Egypt and the region — the partner organizations turn to when they need their operations, compliance, and technology to work as one seamless system.
            </p>
          </div>
          <div class="card vm-card">
            <div class="icon-wrapper">
              <!-- Mission Icon SVG -->
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Our Mission</h3>
            <p>
              To design, build, and support intelligent, AI-driven software and infrastructure — from ERP and e-tax compliance to websites, mobile apps, and secure networks — that simplify how our clients operate, keep them fully compliant, and give them the technical foundation to scale with confidence.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Values Section -->
    <section class="section values-section">
      <div class="container">
        <div class="section-header center">
          <h2>Our Core Values</h2>
        </div>
        
        <div class="grid-3 values-grid">
          <div class="value-item">
            <h4>Innovation with Purpose</h4>
            <p>Adopting AI and automation where it genuinely improves outcomes, not for its own sake.</p>
          </div>
          <div class="value-item">
            <h4>True Partnership</h4>
            <p>We work embedded with your team, not at arm's length.</p>
          </div>
          <div class="value-item">
            <h4>Integrity</h4>
            <p>Transparent timelines, honest scoping, and accountability at every stage.</p>
          </div>
          <div class="value-item">
            <h4>Precision & Reliability</h4>
            <p>Systems built to run without surprises, backed by rigorous testing and support.</p>
          </div>
          <div class="value-item">
            <h4>Compliance-First Thinking</h4>
            <p>Staying ahead of regulatory change so our clients never have to worry about it.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Capabilities / What We Build CTA -->
    <section class="section capabilities-section">
      <div class="container">
        <div class="cta-box">
          <h2>What We Build</h2>
          <div class="tags-wrapper">
            <span class="tech-tag">ERP</span>
            <span class="tech-tag">E-Taxes</span>
            <span class="tech-tag">Web</span>
            <span class="tech-tag">Mobile</span>
            <span class="tech-tag">Infrastructure</span>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  :root {
    --bg-dark: #0a0a0b;
    --bg-surface: #141416;
    --bg-surface-alt: #1a1a1d;
    --border-color: rgba(255, 255, 255, 0.08);
    --text-primary: #ffffff;
    --text-secondary: #a1a1aa;
    --accent: #ff6a2b;
    --accent-hover: #ff8552;
    --accent-glow: rgba(255, 106, 43, 0.15);
  }

  .about-page {
    background-color: var(--bg-dark);
    color: var(--text-primary);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
  }

  h1, h2, h3, h4, .stat-number {
    font-family: 'Sora', 'IBM Plex Sans', sans-serif;
    color: var(--text-primary);
    margin: 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 5rem 0;
  }

  .section-header.center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3.5rem;
  }

  .section-header h2 {
    font-size: 2.25rem;
    margin-bottom: 1rem;
  }

  /* --- Hero Section --- */
  .hero-section {
    padding-top: 8rem;
    padding-bottom: 4rem;
    background: radial-gradient(circle at 50% 0%, var(--accent-glow) 0%, transparent 60%);
  }

  .hero-content {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 4rem;
  }

  .badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-content h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.2;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .stats-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-color);
  }

  .stat-item {
    flex: 1 1 200px;
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 3rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* --- Our Story Section --- */
  .who-we-are-section {
    background-color: var(--bg-surface);
  }

  .split-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .split-layout {
      grid-template-columns: 1fr 1fr;
    }
  }

  .image-box {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 3rem;
  }

  .logo-wrapper {
    position: relative;
    width: 250px;
    height: 250px;
  }

  .glow-effect {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    background: var(--accent);
    filter: blur(100px);
    opacity: 0.2;
    z-index: 0;
  }

  .floating-logo {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    animation: float 6s ease-in-out infinite;
  }

  .text-box h2 {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .text-box p {
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    font-size: 1.05rem;
  }

  /* --- Vision & Mission Section --- */
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .grid-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .vm-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    padding: 3rem;
    border-radius: 1rem;
    transition: transform 0.3s ease;
  }

  .vm-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 106, 43, 0.3);
  }

  .icon-wrapper {
    width: 60px;
    height: 60px;
    background: var(--bg-surface-alt);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .vm-card h3 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .vm-card p {
    color: var(--text-secondary);
  }

  /* --- Values Section --- */
  .values-section {
    background-color: var(--bg-surface);
  }

  .grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .value-item {
    background: var(--bg-dark);
    padding: 2rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border-color);
    border-top: 3px solid var(--accent);
  }

  .value-item h4 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .value-item p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  /* --- Capabilities Section --- */
  .capabilities-section {
    padding-bottom: 8rem;
  }

  .cta-box {
    background: linear-gradient(145deg, var(--bg-surface) 0%, var(--bg-dark) 100%);
    border: 1px solid var(--border-color);
    border-radius: 1.5rem;
    padding: 4rem 2rem;
    text-align: center;
  }

  .cta-box h2 {
    font-size: 2.25rem;
    margin-bottom: 2.5rem;
  }

  .tags-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .tech-tag {
    background: var(--bg-surface-alt);
    border: 1px solid rgba(255, 106, 43, 0.2);
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .tech-tag:hover {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  /* --- Animations --- */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-logo {
      animation: none;
    }
  }
</style>