<script>
  function setupScrollObserver() {
    const cards = Array.from(document.querySelectorAll('.pop-card'));

    const limit = track.scrollWidth / 3;
    let offset = -limit;
    const speed = 0.5;

function animateMarquee() {
  offset += speed;
  if (offset >= 0) {
    offset = -limit;
  }
  // Use optional chaining (track?.style) or keep it wrapped in a null-check
  if (track) {
    track.style.transform = `translateX(${offset}px)`;
  }

  // Scroll-following spotlight: writes a single transform per animation
  // frame, throttled to the frame rate via requestAnimationFrame and
  // capped so the light settles into place instead of chasing scroll
  // position indefinitely. transform is compositor-only — this never
  // triggers layout or paint, so it stays cheap no matter how long the
  // page is.
  function setupScrollLight() {
    const light = document.getElementById('scroll-light');
    if (!light) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    const MAX_DRIFT = 260; // px — how far the light is allowed to drift down
    const DRIFT_FACTOR = 0.12; // fraction of scroll distance it follows
    let ticking = false;

    function update() {
  if (!light) return;
  const y = Math.min(window.scrollY * DRIFT_FACTOR, MAX_DRIFT);
  light.style.transform = `translate3d(0, ${y}px, 0)`;
  ticking = false;
}

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupScrollObserver();
    setupScrollLight();
  });
  document.addEventListener('astro:page-load', () => {
    setupScrollObserver();
    setupScrollLight();
  });
</script> 