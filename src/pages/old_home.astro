---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home - M2-Square">
  <main class="pt-24 pb-24 relative overflow-x-hidden bg-[radial-gradient(ellipse_120%_60%_at_50%_-10%,_#1a1310_0%,_#0a0a0c_55%,_#08080a_100%)] text-white">
    <!-- Subtle full-page grid texture -->
    <div class="bg-grid absolute inset-0 pointer-events-none z-0"></div>

    <!-- Ambient background glows -->
    <div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-[#ff6a2b]/10 rounded-full blur-[150px] pointer-events-none z-0"></div>
    <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-[#ffb59a]/5 blur-[120px] rounded-full pointer-events-none z-0"></div>

   
    <!-- Canvas for interactive dots & lines -->
    <div class="fixed inset-0 w-full h-full z-0 pointer-events-none">
      <canvas id="particles-canvas" class="w-full h-full opacity-70"></canvas>
    </div>

    <!-- Background glow elements -->
    <div class="absolute top-1/4 -left-1/4 w-[800px] h-[800px] bg-[#ff6a2b]/10 rounded-full blur-[150px] pointer-events-none mix-blend-screen z-0"></div>
    <div class="absolute bottom-1/4 -right-1/4 w-[600px] h-[600px] bg-[#ff8552]/10 rounded-full blur-[120px] pointer-events-none mix-blend-screen z-0"></div>
    
    <!-- Main Hero Card -->
    <section class="w-full px-6 md:px-16 pt-12 md:pt-20 pb-8 flex flex-col md:flex-row items-center relative z-10 min-h-[90vh]">
      <div class="w-full md:w-1/2 min-w-[500px] max-w-[780px] flex flex-col justify-between items-start text-left relative z-10 bg-gradient-to-br from-[#2a1c17]/90 via-[#1d100c]/95 to-[#131316]/90 p-8 md:p-12 rounded-3xl border border-[#2e282b]/60 shadow-[0_12px_48px_rgba(0,0,0,0.8)]">
        
        <div class="space-y-6 w-full">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 border border-[#2e282b] rounded-full bg-[#1a1618]">
            <span class="w-2.5 h-2.5 rounded-full bg-[#ff6a2b] shadow-[0_0_10px_rgba(255,106,43,0.8)] animate-pulse"></span>
            <span class="font-mono text-xs text-white/90 uppercase tracking-widest">System Status: Optimal</span>
          </div>
          
          <h1 class="font-sans text-6xl md:text-7xl lg:text-8xl text-white font-bold tracking-tight leading-[1.05]">
            Precision in <br>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#ff6a2b] to-[#ff8552] drop-shadow-[0_0_15px_rgba(255,106,43,0.3)]">Digital Infrastructure.</span>
          </h1>
          
          <p class="font-sans text-xl text-[#a3a0a2] max-w-[680px] pt-3 leading-relaxed">
            Engineer-to-engineer clarity. We architect resilient systems, secure networks, and scalable platforms for the modern enterprise.
            If you need an AI-driven solution that runs without you watching it, we build it.
          </p>
        </div>
        
        <div class="flex flex-col sm:flex-row items-center gap-4 pt-8 w-full sm:w-auto">
          <a href="/services" class="text-center w-full sm:w-auto bg-[#ff6a2b] text-white font-sans text-sm font-semibold px-6 py-3 rounded-xl hover:bg-[#ff8552] transition-all duration-300 shadow-[0_0_20px_rgba(255,106,43,0.4)]">
            Explore Solutions
          </a>
          <a href="/about" class="text-center w-full sm:w-auto border border-[#4a4246] bg-[#1a1618] text-white font-sans text-sm font-semibold px-6 py-3 rounded-xl hover:bg-[#262023] transition-all duration-300">
            View Documentation
          </a>
        </div>
      </div>
    </section>

    <!-- 2. "WHO IS IT FOR?" CORE CARDS SECTION -->
    <section class="py-24 px-6 max-w-7xl mx-auto relative z-10 flex flex-col items-center">
      <div class="w-full max-w-2xl text-center mb-4 flex justify-center">
        <h2 class="text-3xl sm:text-5xl font-bold text-[#F5F5F4] whitespace-nowrap min-w-max">
          Who Is It For?
        </h2>
      </div>

      <div class="w-full max-w-2xl text-center mb-16 px-4">
        <p class="text-[#A3A3AA] text-base sm:text-lg leading-relaxed text-center block w-full min-w-[280px] sm:min-w-[500px]">
          Engineered for businesses that need every branch, warehouse, and ledger entry to agree with each other. Stripped of unnecessary complexity and built for absolute traceability.
        </p>
      </div>

      <!-- 3-Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 w-full perspective-1000">
        <div class="pop-card group relative p-10 rounded-3xl bg-[#131316]/60 border border-white/10 backdrop-blur-xl flex flex-col items-center text-center transition-all duration-300 hover:-translate-y-2 hover:border-[#ff6a2b]/60 hover:shadow-[0_10px_30px_rgba(255,106,43,0.2)]">
          <div class="w-24 h-24 mb-8 flex items-center justify-center rounded-2xl bg-[#1C1C20] border border-white/5 group-hover:scale-110 group-hover:bg-[#ff6a2b]/10 transition-all duration-300">
            <span class="material-symbols-outlined text-4xl text-[#A3A3AA] group-hover:text-[#ff6a2b]">account_balance</span>
          </div>
          <h3 class="text-2xl font-semibold text-[#F5F5F4] mb-4">Financial Integrity</h3>
          <p class="text-[#A3A3AA] leading-relaxed text-base">
            A full accounting engine built on a 4-level chart of accounts and balanced double-entry journals. We do not compromise on the numbers underneath the numbers.
          </p>
        </div>

        <div class="pop-card group relative p-10 rounded-3xl bg-[#131316]/60 border border-white/10 backdrop-blur-xl flex flex-col items-center text-center transition-all duration-300 hover:-translate-y-2 hover:border-[#ff6a2b]/60 hover:shadow-[0_10px_30px_rgba(255,106,43,0.2)]">
          <div class="w-24 h-24 mb-8 flex items-center justify-center rounded-2xl bg-[#1C1C20] border border-white/5 group-hover:scale-110 group-hover:bg-[#ff6a2b]/10 transition-all duration-300">
            <span class="material-symbols-outlined text-4xl text-[#A3A3AA] group-hover:text-[#ff6a2b]">inventory_2</span>
          </div>
          <h3 class="text-2xl font-semibold text-[#F5F5F4] mb-4">Real-Time Visibility</h3>
          <p class="text-[#A3A3AA] leading-relaxed text-base">
            Stock, branches, and warehouses stay in sync the moment a sale, purchase, or transfer happens — no end-of-day reconciliation required.
          </p>
        </div>

        <div class="pop-card group relative p-10 rounded-3xl bg-[#131316]/60 border border-white/10 backdrop-blur-xl flex flex-col items-center text-center transition-all duration-300 hover:-translate-y-2 hover:border-[#ff6a2b]/60 hover:shadow-[0_10px_30px_rgba(255,106,43,0.2)]">
          <div class="w-24 h-24 mb-8 flex items-center justify-center rounded-2xl bg-[#1C1C20] border border-white/5 group-hover:scale-110 group-hover:bg-[#ff6a2b]/10 transition-all duration-300">
            <span class="material-symbols-outlined text-4xl text-[#A3A3AA] group-hover:text-[#ff6a2b]">fact_check</span>
          </div>
          <h3 class="text-2xl font-semibold text-[#F5F5F4] mb-4">Built-In Accountability</h3>
          <p class="text-[#A3A3AA] leading-relaxed text-base">
            Every entry, return, and transfer leaves a trail. Unbalanced-entry detection and full audit reports catch discrepancies before they become problems.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. INTERACTIVE ORBITAL NETWORK VISUAL SECTION (Module Ecosystem) -->
    <section class="py-28 md:py-36 px-6 relative z-10 flex flex-col items-center border-t border-b border-white/5 bg-[#0d0d10]/50">
      <div class="w-full max-w-2xl text-center mb-12 md:mb-16">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[#F5F5F4] mb-4">
          One Core. Every Department.
        </h2>
        <p class="text-[#A3A3AA] text-base sm:text-lg">
          Every module reads and writes to the same core — a sale updates inventory, a purchase updates accounts, automatically.
        </p>
      </div>

      <div class="orbit-track w-full max-w-6xl mx-auto h-[640px] sm:h-[760px] md:h-[900px] lg:h-[1060px] relative flex items-center justify-center overflow-hidden">
        <!-- Ambient pulsing glow field behind everything -->
        <div class="orbit-bg-glow"></div>

        <!-- Slowly rotating conic "energy field" -->
        <div class="orbit-conic-field"></div>

        <!-- Twinkling particle field -->
        <div class="orbit-particles" aria-hidden="true">
          <span class="particle" style="top:10%; left:18%; --size:3px; --delay:0s; --dur:4.5s;"></span>
          <span class="particle" style="top:16%; left:72%; --size:2px; --delay:1.1s; --dur:5.2s;"></span>
          <span class="particle" style="top:28%; left:45%; --size:2px; --delay:2s; --dur:4s;"></span>
          <span class="particle" style="top:34%; left:88%; --size:3px; --delay:0.6s; --dur:5.8s;"></span>
          <span class="particle" style="top:42%; left:8%; --size:2px; --delay:2.6s; --dur:4.6s;"></span>
          <span class="particle" style="top:55%; left:30%; --size:3px; --delay:1.6s; --dur:5s;"></span>
          <span class="particle" style="top:60%; left:78%; --size:2px; --delay:0.3s; --dur:4.2s;"></span>
          <span class="particle" style="top:68%; left:55%; --size:2px; --delay:2.2s; --dur:5.4s;"></span>
          <span class="particle" style="top:74%; left:15%; --size:3px; --delay:1.4s; --dur:4.8s;"></span>
          <span class="particle" style="top:80%; left:65%; --size:2px; --delay:0.9s; --dur:5.6s;"></span>
          <span class="particle" style="top:20%; left:60%; --size:2px; --delay:1.8s; --dur:4.4s;"></span>
          <span class="particle" style="top:88%; left:38%; --size:3px; --delay:2.4s; --dur:5.1s;"></span>
        </div>

        <!-- Concentric Radial Orbit Lines -->
        <div class="absolute rounded-full border border-white/10 animate-spin-slow w-[460px] h-[460px] sm:w-[520px] sm:h-[520px] md:w-[600px] md:h-[600px] lg:w-[680px] lg:h-[680px]"></div>
        <div class="absolute rounded-full border border-white/5 animate-spin-reverse w-[680px] h-[680px] sm:w-[780px] sm:h-[780px] md:w-[880px] md:h-[880px] lg:w-[1000px] lg:h-[1000px]"></div>
        <div class="absolute rounded-full border border-white/[0.02] w-[780px] h-[780px] sm:w-[880px] sm:h-[880px] md:w-[1000px] md:h-[1000px] lg:w-[1150px] lg:h-[1150px]"></div>

        <!-- Central Illuminated Node — animated, recolored logo -->
        <div class="core-hub z-10 relative flex flex-col items-center justify-center text-center">
          <div class="core-logo-frame">
            <div class="core-logo-glow"></div>
            <div class="core-hub-ring"></div>
            <div class="core-hub-ring core-hub-ring-2"></div>
            <img src="/assets/Logo.png" alt="M2 ERP Core" class="core-logo-img" />
          </div>
          <span class="font-mono text-[10px] sm:text-xs md:text-sm text-[#ff6a2b] uppercase tracking-widest block font-bold mt-4">M2 ERP Core</span>
        </div>

        <!-- Orbiting Satellites — Inner Ring (spins with the innermost line) -->
        <div class="orbit-ring-item orbit-inner" style="--duration:30s; --delay:0s; --dir:1;">
          <div class="orbit-card">
            <div class="pop-card is-visible whitespace-nowrap p-2.5 sm:p-3 md:p-4 lg:p-5 rounded-xl bg-[#131316]/80 border border-white/10 backdrop-blur-md flex items-center gap-2 sm:gap-3 shadow-lg shadow-black/30">
              <span class="material-symbols-outlined text-[#ff6a2b] text-base sm:text-lg md:text-xl lg:text-2xl">account_balance</span>
              <span class="text-[9px] sm:text-[10px] md:text-xs lg:text-sm font-mono text-[#E5E5E5]">General Ledger</span>
            </div>
          </div>
        </div>
        <div class="orbit-ring-item orbit-inner" style="--duration:30s; --delay:-10s; --dir:1;">
          <div class="orbit-card">
            <div class="pop-card is-visible whitespace-nowrap p-2.5 sm:p-3 md:p-4 lg:p-5 rounded-xl bg-[#131316]/80 border border-white/10 backdrop-blur-md flex items-center gap-2 sm:gap-3 shadow-lg shadow-black/30">
              <span class="material-symbols-outlined text-[#ff6a2b] text-base sm:text-lg md:text-xl lg:text-2xl">inventory_2</span>
              <span class="text-[9px] sm:text-[10px] md:text-xs lg:text-sm font-mono text-[#E5E5E5]">Inventory</span>
            </div>
          </div>
        </div>
        <div class="orbit-ring-item orbit-inner" style="--duration:30s; --delay:-20s; --dir:1;">
          <div class="orbit-card">
            <div class="pop-card is-visible whitespace-nowrap p-2.5 sm:p-3 md:p-4 lg:p-5 rounded-xl bg-[#131316]/80 border border-white/10 backdrop-blur-md flex items-center gap-2 sm:gap-3 shadow-lg shadow-black/30">
              <span class="material-symbols-outlined text-[#ff6a2b] text-base sm:text-lg md:text-xl lg:text-2xl">groups</span>
              <span class="text-[9px] sm:text-[10px] md:text-xs lg:text-sm font-mono text-[#E5E5E5]">Human Resources</span>
            </div>
          </div>
        </div>

        <!-- Orbiting Satellites — Outer Ring (spins opposite direction) -->
        <div class="orbit-ring-item orbit-outer" style="--duration:45s; --delay:0s; --dir:-1;">
          <div class="orbit-card">
            <div class="pop-card is-visible whitespace-nowrap p-2.5 sm:p-3 md:p-4 lg:p-5 rounded-xl bg-[#131316]/80 border border-white/10 backdrop-blur-md flex items-center gap-2 sm:gap-3 shadow-lg shadow-black/30">
              <span class="material-symbols-outlined text-[#ff6a2b] text-base sm:text-lg md:text-xl lg:text-2xl">shopping_cart</span>
              <span class="text-[9px] sm:text-[10px] md:text-xs lg:text-sm font-mono text-[#E5E5E5]">Purchasing</span>
            </div>
          </div>
        </div>
        <div class="orbit-ring-item orbit-outer" style="--duration:45s; --delay:-15s; --dir:-1;">
          <div class="orbit-card">
            <div class="pop-card is-visible whitespace-nowrap p-2.5 sm:p-3 md:p-4 lg:p-5 rounded-xl bg-[#131316]/80 border border-white/10 backdrop-blur-md flex items-center gap-2 sm:gap-3 shadow-lg shadow-black/30">
              <span class="material-symbols-outlined text-[#ff6a2b] text-base sm:text-lg md:text-xl lg:text-2xl">point_of_sale</span>
              <span class="text-[9px] sm:text-[10px] md:text-xs lg:text-sm font-mono text-[#E5E5E5]">Sales</span>
            </div>
          </div>
        </div>
        <div class="orbit-ring-item orbit-outer" style="--duration:45s; --delay:-30s; --dir:-1;">
          <div class="orbit-card">
            <div class="pop-card is-visible whitespace-nowrap p-2.5 sm:p-3 md:p-4 lg:p-5 rounded-xl bg-[#131316]/80 border border-white/10 backdrop-blur-md flex items-center gap-2 sm:gap-3 shadow-lg shadow-black/30">
              <span class="material-symbols-outlined text-[#ff6a2b] text-base sm:text-lg md:text-xl lg:text-2xl">support_agent</span>
              <span class="text-[9px] sm:text-[10px] md:text-xs lg:text-sm font-mono text-[#E5E5E5]">Customer Service</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. FEATURE CAPABILITIES GRID (2-COL) -->
    <section class="py-24 px-6 max-w-7xl mx-auto relative z-10 overflow-hidden">
      <div class="absolute top-10 -left-20 w-[420px] h-[420px] bg-[#ff6a2b]/8 rounded-full blur-[150px] pointer-events-none z-0"></div>
      <div class="absolute bottom-0 -right-20 w-[380px] h-[380px] bg-[#ffb59a]/6 rounded-full blur-[140px] pointer-events-none z-0"></div>
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-5xl font-bold text-[#F5F5F4] mb-4">Inside the Platform</h2>
        <p class="text-[#A3A3AA] text-base sm:text-lg max-w-2xl mx-auto">
          Every module is built the way businesses actually operate — layered, structured, and detail-obsessed.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 perspective-1000">
        <div class="pop-card p-10 rounded-3xl bg-[#131316]/40 border border-white/10 hover:border-[#ff6a2b]/40 transition-all flex gap-6">
          <div class="p-5 bg-[#1C1C20] rounded-2xl border border-white/5 h-fit text-[#ff6a2b]">
            <span class="material-symbols-outlined text-4xl">account_balance_wallet</span>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white mb-3">General Ledger & Accounting</h3>
            <p class="text-[#A3A3AA] text-base leading-relaxed">
              Banks, treasuries, and branch accounts sit on top of a 4-level chart of accounts. Daily journal entries roll straight into trial balances, financial statements, and an unbalanced-entries report — every one exportable to Excel.
            </p>
          </div>
        </div>

        <div class="pop-card p-10 rounded-3xl bg-[#131316]/40 border border-white/10 hover:border-[#ff6a2b]/40 transition-all flex gap-6">
          <div class="p-5 bg-[#1C1C20] rounded-2xl border border-white/5 h-fit text-[#ff6a2b]">
            <span class="material-symbols-outlined text-4xl">warehouse</span>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white mb-3">Inventory & Warehouse Management</h3>
            <p class="text-[#A3A3AA] text-base leading-relaxed">
              Departments, groups, and item cards track live balances, min/max thresholds, and cost across unlimited branches. Addition, deduction, and transfer notes keep every stock movement logged and traceable.
            </p>
          </div>
        </div>

        <div class="pop-card p-10 rounded-3xl bg-[#131316]/40 border border-white/10 hover:border-[#ff6a2b]/40 transition-all flex gap-6">
          <div class="p-5 bg-[#1C1C20] rounded-2xl border border-white/5 h-fit text-[#ff6a2b]">
            <span class="material-symbols-outlined text-4xl">local_shipping</span>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white mb-3">Purchasing & Vendor Management</h3>
            <p class="text-[#A3A3AA] text-base leading-relaxed">
              A full supplier directory feeds directly into purchase invoices and returns, with itemized quantities, discounts, and automatic tax — summarized or detailed, for any date range.
            </p>
          </div>
        </div>

        <div class="pop-card p-10 rounded-3xl bg-[#131316]/40 border border-white/10 hover:border-[#ff6a2b]/40 transition-all flex gap-6">
          <div class="p-5 bg-[#1C1C20] rounded-2xl border border-white/5 h-fit text-[#ff6a2b]">
            <span class="material-symbols-outlined text-4xl">storefront</span>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white mb-3">Sales & Customer Management</h3>
            <p class="text-[#A3A3AA] text-base leading-relaxed">
              Sales reps, customer accounts, invoices, and returns are all linked back to branch, treasury, and ledger — so every deal is traceable from quote to closed book.
            </p>
          </div>
        </div>
      </div>
    </section>

        <!-- Infinite Scroll / Marquee Section -->
    <section class="w-full max-w-[1400px] mx-auto px-6 md:px-16 my-16 relative z-10">
      <div class="bg-gradient-to-br from-[#2a1c17]/60 via-[#1d100c]/80 to-[#131316]/60 border border-[#2e282b]/60 rounded-2xl p-4 shadow-[0_16px_48px_rgba(0,0,0,0.7)] overflow-hidden relative">
        <div id="marquee-container" class="relative w-full overflow-x-hidden select-none [mask-image:linear-gradient(to_right,transparent,black_5%,black_95%,transparent)]">
          <div id="clients-track" class="flex gap-4 py-1 items-center w-max">
            <!-- Dynamically populated via script -->
          </div>
        </div>
      </div>
    </section>

    <!-- 5. METRICS & STATS SECTION -->
    <section class="py-16 px-6 max-w-7xl mx-auto relative z-10 mb-16 overflow-hidden">
      <div class="absolute inset-0 bg-[#ff6a2b]/5 rounded-3xl blur-[80px] -z-10"></div>
      <div class="absolute -top-10 left-1/3 w-[360px] h-[360px] bg-[#ff6a2b]/7 rounded-full blur-[140px] pointer-events-none z-0"></div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="pop-card p-8 text-center bg-[#131316]/40 border border-white/5 rounded-2xl backdrop-blur-md">
          <div class="font-mono text-3xl font-semibold text-[#ff6a2b] mb-2 drop-shadow-[0_0_8px_rgba(255,106,43,0.5)]">8</div>
          <div class="text-sm text-[#A3A3AA] uppercase tracking-wider">Core Modules</div>
        </div>
        <div class="pop-card p-8 text-center bg-[#131316]/40 border border-white/5 rounded-2xl backdrop-blur-md">
          <div class="font-mono text-3xl font-semibold text-[#ff6a2b] mb-2 drop-shadow-[0_0_8px_rgba(255,106,43,0.5)]">4-Level</div>
          <div class="text-sm text-[#A3A3AA] uppercase tracking-wider">Chart of Accounts</div>
        </div>
        <div class="pop-card p-8 text-center bg-[#131316]/40 border border-white/5 rounded-2xl backdrop-blur-md">
          <div class="font-mono text-3xl font-semibold text-[#ff6a2b] mb-2 drop-shadow-[0_0_8px_rgba(255,106,43,0.5)]">Real-Time</div>
          <div class="text-sm text-[#A3A3AA] uppercase tracking-wider">Stock & Ledger Sync</div>
        </div>
        <div class="pop-card p-8 text-center bg-[#131316]/40 border border-white/5 rounded-2xl backdrop-blur-md">
          <div class="font-mono text-3xl font-semibold text-[#ff6a2b] mb-2 drop-shadow-[0_0_8px_rgba(255,106,43,0.5)]">100%</div>
          <div class="text-sm text-[#A3A3AA] uppercase tracking-wider">Excel-Exportable Reports</div>
        </div>
      </div>
    </section>

    <!-- 6. FINAL CTA BANNER -->
<section class="py-20 px-6 max-w-5xl mx-auto relative z-10 text-center perspective-1000 overflow-hidden">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-[#ff6a2b]/8 rounded-full blur-[160px] pointer-events-none z-0"></div>
  <div class="pop-card p-12 sm:p-16 rounded-3xl bg-gradient-to-b from-[#131316] to-[#0d0d10] border border-[#ff6a2b]/30 shadow-[0_0_50px_rgba(255,106,43,0.15)] flex flex-col items-center w-full relative z-10">
    
    <h2 class="text-3xl sm:text-5xl font-bold text-white mb-6 w-full">
      Ready to Unify Your Business Systems?
    </h2>

    <p class="text-[#A3A3AA] text-base sm:text-lg mb-8 max-w-xl w-full min-w-full sm:min-w-[500px]">
      One platform for finance, inventory, purchasing, and sales — built for accuracy, traceability, and zero-compromise reporting.
    </p>

