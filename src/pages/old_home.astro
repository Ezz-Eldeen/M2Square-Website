<style>
  .perspective-1000 {
    perspective: 1000px;
  }

  /* Pop-in Entrance Base State */
  .pop-card {
    opacity: 0;
    transform: translateY(60px) scale(0.8) rotateX(15deg);
    transition: opacity 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275),
                transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    will-change: transform, opacity;
  }

  /* Triggered State */
  .pop-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1) rotateX(0deg);
  }

  /* Keyframe Animations */
  @keyframes zoomInFade {
    0% { opacity: 0; transform: scale(0.6); }
    100% { opacity: 1; transform: scale(1); }
  }

  @keyframes fastBreath {
    0%, 100% { transform: translate(-50%, -50%) scale(0.85); opacity: 0.4; }
    50% { transform: translate(-50%, -50%) scale(1.35); opacity: 0.85; }
  }

  @keyframes logoCombined {
    0%, 100% { filter: drop-shadow(0 0 35px rgba(255, 106, 43, 0.3)); transform: translateY(0px); }
    50% { filter: drop-shadow(0 0 75px rgba(255, 106, 43, 0.75)); transform: translateY(-14px); }
  }

  @keyframes spinSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes spinReverse {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  .animate-spin-slow { animation: spinSlow 30s linear infinite; }
  .animate-spin-reverse { animation: spinReverse 45s linear infinite; }
  .animate-zoom-in { animation: zoomInFade 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .animate-fast-breath { animation: fastBreath 2.5s ease-in-out infinite; }
  .animate-logo-combined { animation: logoCombined 3s ease-in-out infinite; }

  /* Full-page grid texture, faded out at top and bottom edges */
  .bg-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  /* Orbit section ambient background effects */
  .orbit-bg-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(255, 106, 43, 0.16) 0%, rgba(255, 106, 43, 0.05) 35%, transparent 70%);
    animation: orbitGlowPulse 6s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }

  .orbit-conic-field {
    position: absolute;
    width: 90%;
    max-width: 900px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: conic-gradient(from 0deg, rgba(255, 106, 43, 0.14), transparent 25%, rgba(255, 181, 154, 0.1) 50%, transparent 75%, rgba(255, 106, 43, 0.14));
    filter: blur(60px);
    animation: spinReverse 60s linear infinite;
    pointer-events: none;
    z-index: 0;
  }

  @keyframes orbitGlowPulse {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.08); }
  }

  .orbit-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .particle {
    position: absolute;
    width: var(--size, 2px);
    height: var(--size, 2px);
    border-radius: 50%;
    background: #ffb59a;
    box-shadow: 0 0 6px 1px rgba(255, 106, 43, 0.8);
    animation: particleTwinkle var(--dur, 4s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }

  @keyframes particleTwinkle {
    0%, 100% { opacity: 0.15; transform: translateY(0) scale(1); }
    50% { opacity: 0.9; transform: translateY(-14px) scale(1.4); }
  }

  /* Animated, recolored logo at the center of the orbit */
  .core-hub {
    z-index: 10;
  }

  .core-logo-frame {
    position: relative;
    width: 96px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 640px) { .core-logo-frame { width: 116px; height: 116px; } }
  @media (min-width: 768px) { .core-logo-frame { width: 136px; height: 136px; } }
  @media (min-width: 1024px) { .core-logo-frame { width: 156px; height: 156px; } }

  .core-logo-frame::before {
    content: '';
    position: absolute;
    inset: -14px;
    background: radial-gradient(circle, rgba(19, 19, 22, 0.92) 0%, rgba(19, 19, 22, 0.5) 55%, transparent 80%);
    border-radius: 50%;
    z-index: 1;
    pointer-events: none;
  }

  .core-logo-glow {
    position: absolute;
    width: 220%;
    height: 220%;
    background: radial-gradient(circle, rgba(255, 106, 43, 0.45) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(16px);
    animation: fastBreath 3s ease-in-out infinite;
    z-index: 0;
    pointer-events: none;
  }

  .core-hub-ring {
    position: absolute;
    inset: -16px;
    border-radius: 50%;
    border: 1.5px dashed rgba(255, 106, 43, 0.5);
    animation: spinSlow 18s linear infinite;
    pointer-events: none;
    z-index: 2;
  }

  .core-hub-ring-2 {
    inset: -32px;
    border: 1px solid rgba(255, 181, 154, 0.25);
    animation: spinReverse 26s linear infinite;
  }

  .core-logo-img {
    position: relative;
    width: 72%;
    height: 72%;
    object-fit: contain;
    z-index: 3;
    filter: grayscale(1) brightness(1.5) contrast(1.15) drop-shadow(0 0 25px rgba(255, 106, 43, 0.6));
    animation: logoBreathe 4s ease-in-out infinite;
  }

  .core-logo-frame::after {
    content: '';
    position: absolute;
    width: 72%;
    height: 72%;
    background: radial-gradient(circle, rgba(255, 106, 43, 0.95) 0%, rgba(255, 181, 154, 0.55) 55%, transparent 80%);
    mix-blend-mode: color;
    z-index: 4;
    pointer-events: none;
    border-radius: 50%;
  }

  @keyframes logoBreathe {
    0%, 100% { transform: scale(1); filter: grayscale(1) brightness(1.5) contrast(1.15) drop-shadow(0 0 25px rgba(255, 106, 43, 0.55)); }
    50% { transform: scale(1.06); filter: grayscale(1) brightness(1.6) contrast(1.2) drop-shadow(0 0 45px rgba(255, 106, 43, 0.9)); }
  }

  /* Orbiting Satellite System */

  /* Radius is set responsively here (not inline) so it can grow with the
     hub + card sizes at each breakpoint — widened further so satellites
     never collide with the central hub or with each other. */
  .orbit-track {
    --r-inner: 230px;
    --r-outer: 340px;
  }
  @media (min-width: 640px) {
    .orbit-track { --r-inner: 260px; --r-outer: 390px; }
  }
  @media (min-width: 768px) {
    .orbit-track { --r-inner: 300px; --r-outer: 440px; }
  }
  @media (min-width: 1024px) {
    .orbit-track { --r-inner: 340px; --r-outer: 500px; }
  }

  .orbit-inner { --r: var(--r-inner); }
  .orbit-outer { --r: var(--r-outer); }

  .orbit-ring-item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    animation: orbitSpin var(--duration) linear infinite;
    animation-delay: var(--delay);
  }

  /* The card is pushed out to its radius, then spins the opposite way
     of its parent so the label itself never rotates — it just travels. */
  .orbit-card {
    position: absolute;
    top: calc(-1 * var(--r));
    left: 0;
    animation: orbitCounterSpin var(--duration) linear infinite;
    animation-delay: var(--delay);
  }

  @keyframes orbitSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(calc(360deg * var(--dir, 1))); }
  }

  @keyframes orbitCounterSpin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to   { transform: translate(-50%, -50%) rotate(calc(-360deg * var(--dir, 1))); }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-ring-item, .orbit-card, .animate-spin-slow, .animate-spin-reverse,
    .orbit-bg-glow, .orbit-conic-field, .particle, .core-hub-ring, .core-logo-glow, .core-logo-img {
      animation: none;
    }
  }
</style>

<!-- Queued Stagger Animation Script -->
<script>


  // Canvas Particles Animation Script
  const canvas = document.getElementById('particles-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);
    let particles: Particle[] = [];
    let mouse = { x: -1000, y: -1000 };

    class Particle {
      x = Math.random() * width;
      y = Math.random() * height;
      vx = (Math.random() - 0.5) * 1.5;
      vy = (Math.random() - 0.5) * 1.5;
      size = Math.random() * 2 + 1.5;

      update() {
        const dx = this.x - mouse.x;
        const dy = this.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 150) {
          const angle = Math.atan2(dy, dx);
          this.x += Math.cos(angle) * 3;
          this.y += Math.sin(angle) * 3;
        }
        this.x += this.vx;
        this.y += this.vy;
        if (this.x < 0 || this.x > width) this.vx *= -1;
        if (this.y < 0 || this.y > height) this.vy *= -1;
      }

      draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255, 106, 43, 0.85)';
        ctx.fill();
      }
    }

    function init() {
      particles = Array.from({ length: 120 }, () => new Particle());
    }

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      init();
    });

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    init();

    function animate() {
      ctx.clearRect(0, 0, width, height);
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 140) {
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `rgba(255, 106, 43, ${ (1 - dist / 140) * 0.35 })`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
      }
      particles.forEach((p) => { p.update(); p.draw(); });
      requestAnimationFrame(animate);
    }
    animate();
  }
  
  function setupScrollObserver() {
    const cards = Array.from(document.querySelectorAll('.pop-card'));

    const observerOptions = {
      root: null,
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const cardIndex = cards.indexOf(entry.target);

          // Queue entrance: delay each card by 150ms sequentially
          setTimeout(() => {
            entry.target.classList.add('is-visible');
          }, (cardIndex % 4) * 150);

          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    cards.forEach((card) => observer.observe(card));
  }

  document.addEventListener('DOMContentLoaded', setupScrollObserver);
  document.addEventListener('astro:page-load', setupScrollObserver);


  // Infinite Scroll / Marquee Script
  const clients = [
    { name: "#1", url: "#" },
    { name: "#2", url: "#" },
    { name: "#3", url: "#" },
    { name: "#4", url: "#" },
    { name: "#5", url: "#" },
    { name: "#6", url: "#" },
    { name: "#7", url: "#" },
    { name: "#8", url: "#" }
  ];

  const track = document.getElementById('clients-track');
  if (track) {
    const clientHTML = clients.map(client => `
      <a href="${client.url}" class="flex items-center gap-2 px-4 py-2 bg-[#1a1618] border border-[#2e282b] rounded-xl whitespace-nowrap hover:border-[#ff6a2b] transition-all duration-300 shadow-md group">
        <span class="w-2 h-2 rounded-full bg-[#ff6a2b] shadow-[0_0_8px_rgba(255,106,43,0.8)]"></span>
        <span class="font-sans text-white font-semibold text-sm group-hover:text-[#ff6a2b] transition-colors">${client.name}</span>
      </a>
    `).join('');

    track.innerHTML = clientHTML + clientHTML + clientHTML;

    const limit = track.scrollWidth / 3;
    let offset = -limit;
    const speed = 0.5;

function animateMarquee() {
  offset += speed;
  if (offset >= 0) {
    offset = -limit;
  }
  // Use optional chaining (track?.style) or keep it wrapped in a null-check
  if (track) {
    track.style.transform = `translateX(${offset}px)`;
  }
  requestAnimationFrame(animateMarquee);
}

    animateMarquee();
  }













