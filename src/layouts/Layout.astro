---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logoImage from '../assets/Logo.png';
import faviconImage from '../assets/favicon.png';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const SITE = 'https://website-one-beige-21.vercel.app';

const {
  title = "M-Square",
  description = "M-Square builds AI-driven ERP systems, ETA e-invoicing, websites, mobile apps and IT infrastructure for businesses in Egypt. Start your project today.",
  ogImage = `${SITE}/og-image.png`,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE).href;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "M-Square",
  url: SITE,
  logo: `${SITE}${logoImage.src}`,
};

// Normalize path to ignore trailing slashes
const rawPath = Astro.url.pathname;
const currentPath = rawPath.endsWith('/') && rawPath !== '/' ? rawPath.slice(0, -1) : rawPath;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <!-- Favicon / Website Icon -->
  <link rel="icon" type="image/png" href={faviconImage.src} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

  <title>{title}</title>
    <!-- SEO / Open Graph -->
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
</head>

<body class="bg-[#03111F] text-text-primary font-display antialiased selection:bg-[#D29D52]/30 selection:text-white overflow-x-hidden">

  <!-- Navigation Bar -->
  <nav class="fixed top-0 w-full z-50 bg-[#03111F]/90 backdrop-blur-md border-b border-[#D29D52]/15 transition-all duration-300">
    <div class="flex justify-between items-center h-28 px-gutter-mobile md:px-gutter-desktop max-w-[1440px] mx-auto">
      <a class="flex items-center gap-2 font-display text-headline-sm font-bold tracking-tight" href="/">
        <Image
          src={logoImage}
          alt="M-Square Logo"
          loading="eager"
          class="h-[84px] w-auto object-contain drop-shadow-[0_0_15px_rgba(210,157,82,0.35)]"
          style="width: auto;"
        />
      </a>

      <!-- Desktop Menu -->
      <ul class="hidden md:flex space-x-lg items-center">
        <li>
          <a class={`font-display text-body-md transition-colors duration-200 ${currentPath === '/' ? 'text-[#D29D52] font-semibold border-b-2 border-[#D29D52] pb-1' : 'text-white/60 hover:text-[#3BAAEF]'}`} href="/">
            Home
          </a>
        </li>
        <li>
          <a class={`font-display text-body-md transition-colors duration-200 ${currentPath === '/about' ? 'text-[#D29D52] font-semibold border-b-2 border-[#D29D52] pb-1' : 'text-white/60 hover:text-[#3BAAEF]'}`} href="/about">
            About Us
          </a>
        </li>
        <li>
          <a class={`font-display text-body-md transition-colors duration-200 ${currentPath === '/contact' ? 'text-[#D29D52] font-semibold border-b-2 border-[#D29D52] pb-1' : 'text-white/60 hover:text-[#3BAAEF]'}`} href="/contact">
            Contact Us
          </a>
        </li>
      </ul>

      <div class="hidden md:flex items-center gap-md">
        <a
          href="/contact"
          class="font-label-md font-semibold px-md py-xs rounded-xl transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[#076CC7] focus:ring-offset-2 focus:ring-offset-[#03111F] shadow-[0_0_20px_rgba(210,157,82,0.3)] hover:shadow-[0_0_30px_rgba(210,157,82,0.5)]"
          style="background: linear-gradient(135deg, #664725 0%, #D29D52 35%, #F6C973 60%, #D29D52 100%); color: #03111F;"
        >
          Get Started
        </a>
      </div>

      <button id="menu-btn" aria-label="Toggle Menu" class="md:hidden text-white/80 hover:text-[#D29D52] transition-colors duration-200 select-none">
        <span class="material-symbols-outlined text-[24px]">menu</span>
      </button>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-[#03111F] border-t border-[#D29D52]/15 px-gutter-mobile py-md space-y-sm">
      <a class="block font-display text-body-md text-white/60 hover:text-[#3BAAEF]" href="/">Home</a>
      <a class="block font-display text-body-md text-white/60 hover:text-[#3BAAEF] pt-2" href="/about">About Us</a>
      <a class="block font-display text-body-md text-white/60 hover:text-[#3BAAEF]" href="/contact">Contact Us</a>
      <div class="pt-sm border-t border-[#D29D52]/15 flex flex-col gap-sm">
        <a
          class="text-center font-label-md font-semibold py-xs rounded-xl"
          style="background: linear-gradient(135deg, #664725 0%, #D29D52 35%, #F6C973 60%, #D29D52 100%); color: #03111F;"
          href="/contact"
        >
          Get Started
        </a>
      </div>
    </div>
  </nav>

  <slot />

  <!-- Footer -->
  <footer class="w-full bg-[#03111F] border-t border-[#D29D52]/15 py-section-sm z-10 relative">
    <div class="px-gutter-mobile md:px-gutter-desktop max-w-[1440px] mx-auto grid grid-cols-1 md:grid-cols-4 gap-lg">
      <div class="col-span-1 md:col-span-1">
        <a class="flex items-center gap-2 mb-sm font-display text-headline-sm font-bold tracking-tight" href="/">
          <Image
            src={logoImage}
            alt="M-Square Logo"
            loading="lazy"
            class="h-[92px] w-auto object-contain"
            style="width: auto;"
          />
          <span style="background: linear-gradient(135deg, #664725 0%, #D29D52 35%, #F6C973 60%, #D29D52 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">
            M-Square
          </span>
        </a>
        <p class="font-display text-label-md text-white/40 mb-sm">
          © 2021 M-Square.<br />
          Precision in Digital Infrastructure.
        </p>
      </div>
      <div class="col-span-1">
        <h4 class="font-display text-label-md font-semibold text-[#D29D52] mb-md">Solutions</h4>
        <ul class="space-y-sm">
          <li><a class="font-display text-label-md text-white/50 hover:text-[#3BAAEF] transition-colors duration-200" href="/#digital-transformation">Digital Transformation</a></li>
          <li><a class="font-display text-label-md text-white/50 hover:text-[#3BAAEF] transition-colors duration-200" href="/#project-management">Project Management</a></li>
          <li><a class="font-display text-label-md text-white/50 hover:text-[#3BAAEF] transition-colors duration-200" href="/#e-taxes-solutions">E-Taxes Solutions</a></li>
          <li><a class="font-display text-label-md text-white/50 hover:text-[#3BAAEF] transition-colors duration-200" href="/#web-engineering">Web Development</a></li>
          <li><a class="font-display text-label-md text-white/50 hover:text-[#3BAAEF] transition-colors duration-200" href="/#mobile-apps">Mobile App Development</a></li>
          <li><a class="font-display text-label-md text-white/50 hover:text-[#3BAAEF] transition-colors duration-200" href="/#vps-infrastructure">IT Infrastructure</a></li>
        </ul>
      </div>
      <div class="col-span-1">
        <h4 class="font-display text-label-md font-semibold text-[#D29D52] mb-md">Company</h4>
        <ul class="space-y-sm">
          <li><a class="font-display text-label-md text-white/50 hover:text-[#3BAAEF] transition-colors duration-200" href="/about">About Us</a></li>
          <li><a class="font-display text-label-md text-white hover:text-[#3BAAEF] transition-colors duration-200" href="/contact">Contact</a></li>
          <li><a class="font-display text-label-md text-white/50 hover:text-[#3BAAEF] transition-colors duration-200" href="mailto:sales@m-square.com">sales@m2-square.com</a></li>
        </ul>
      </div>
      <div class="col-span-1">
        <h4 class="font-display text-label-md font-semibold text-[#D29D52] mb-md">Legal</h4>
        <ul class="space-y-sm">
          <li><a class="font-display text-label-md text-white/50 hover:text-[#3BAAEF] transition-colors duration-200" href="/privacy">Privacy Policy</a></li>
          <li><a class="font-display text-label-md text-white/50 hover:text-[#3BAAEF] transition-colors duration-200" href="/terms">Terms of Service</a></li>
        </ul>
      </div>
    </div>
  </footer>

  <script>
    const setupMenu = () => {
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      if (menuBtn && mobileMenu) {
        menuBtn.onclick = () => mobileMenu.classList.toggle('hidden');
      }
    };

    // Initialize on load & Astro page transitions
    setupMenu();
    document.addEventListener('astro:page-load', setupMenu);
  </script>
</body>
</html>