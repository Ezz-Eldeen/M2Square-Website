---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../i18n/utils';

// ==========================================
// SLIDER IMAGES — imported from src/assets/slider
// ==========================================
import slider1Img from '../assets/slider/slider1.jpg';
import slider2Img from '../assets/slider/slider2.jpg';
import slider3Img from '../assets/slider/slider3.jpg';
import slider4Img from '../assets/slider/slider4.jpg';
import slider5Img from '../assets/slider/slider5.jpg';
import slider6Img from '../assets/slider/slider6.jpg';
import slider7Img from '../assets/slider/slider7.jpg';
import slider8Img from '../assets/slider/slider8.jpg';

// ==========================================
// SLIDER CONFIGURATION CONTROLS
// ==========================================

// 1. SPEED CONTROL (in milliseconds: 6000 = 6 seconds per slide)
const slideSpeed = 6000;

// 2. SIZE CONTROL (Tailwind max-width and height classes)
const sliderMaxWidth = "max-w-9xl"; // Try max-w-3xl, max-w-4xl, max-w-6xl
const sliderHeight = "h-[600px] sm:h-[700px]"; // Adjust height for mobile/desktop

// 3. POSITION / ALIGNMENT CONTROL (Tailwind margins/padding)
const sliderAlignment = "mx-auto mt-[75px] mb-[5px]"; // shifted down another ~10%; total (75+5=80px) still unchanged from the original my-10, so no layout shift

// ==========================================
// LANGUAGE
// Wired into the site's actual i18n system (src/i18n/ui.ts +
// src/i18n/utils.ts) rather than a separate hardcoded array, so the
// slider's copy lives in the same dictionary as your nav/footer strings.
// Pass lang="ar" when using this component on an /ar/ page:
//   <ImageSlider lang="ar" />
// Defaults to "en" so any existing usage with no prop keeps working.
// ==========================================
interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const isRtl = lang === "ar";
const t = useTranslations(lang);

const slides = [
  { image: slider1Img, tag: t('slider.erp.tag'), title: t('slider.erp.title'), description: t('slider.erp.description') },
  { image: slider5Img, tag: t('slider.itpm.tag'), title: t('slider.itpm.title'), description: t('slider.itpm.description') },
  { image: slider6Img, tag: t('slider.etax.tag'), title: t('slider.etax.title'), description: t('slider.etax.description') },
  { image: slider4Img, tag: t('slider.web.tag'), title: t('slider.web.title'), description: t('slider.web.description') },
  { image: slider7Img, tag: t('slider.mobile.tag'), title: t('slider.mobile.title'), description: t('slider.mobile.description') },
  { image: slider8Img, tag: t('slider.infra.tag'), title: t('slider.infra.title'), description: t('slider.infra.description') },
];
---

<!-- Position and Size applied via variables -->
<div class={`${sliderMaxWidth} ${sliderAlignment} px-4 sm:px-6`}>
  <div
    id="slider-container"
    class={`hero-slider relative w-full ${sliderHeight} rounded-2xl overflow-hidden border border-white/10 shadow-2xl group cursor-pointer bg-[#03111F] ${isRtl ? 'is-rtl' : ''}`}
    dir={isRtl ? "rtl" : "ltr"}
    lang={lang}
  >

    <!-- Slides Container -->
    <div class="relative w-full h-full">
      {slides.map((slide, index) => (
        <div 
          class={`absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
          data-slide={index}
        >
          <!-- Background Image with Subtle Zoom & Dark Gradient Overlays -->
          <Image
            src={slide.image}
            alt={slide.tag}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 ease-out pointer-events-none"
            loading={index === 0 ? "eager" : "lazy"}
            widths={[480, 768, 1200, 1920]}
            sizes="100vw"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#03111F] via-[#03111F]/70 to-transparent pointer-events-none"></div>
          <div class="absolute inset-0 bg-[#03111F]/30 pointer-events-none"></div>

          <!-- Text Content Overlay -->
          <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-10 max-w-3xl z-20 pointer-events-none">

            <!-- MASSIVE CATCHY TAG (Branded Gold Metallic Gradient) -->
            <div class="mb-3 inline-block">
              <span class="text-2xl sm:text-4xl font-black uppercase tracking-tight bg-gradient-to-r from-[#664725] via-[#D29D52] to-[#F6C973] bg-[length:200%_auto] bg-clip-text text-transparent animate-shine drop-shadow-[0_0_25px_rgba(210,157,82,0.35)]">
                {slide.tag}
              </span>
            </div>

            <!-- Smaller Secondary Title -->
            <h3 class="text-base sm:text-xl font-semibold text-white/95 tracking-wide mb-2 flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-[#D29D52] animate-pulse"></span>
              {slide.title}
            </h3>

            <!-- Description -->
            <p class="text-sm sm:text-base text-[#a9bbcd] leading-relaxed">
              {slide.description}
            </p>

          </div>
        </div>
      ))}
    </div>

    <!-- Pagination Indicators / Dots — mirrored to the opposite corner in RTL -->
    <div class={`absolute bottom-6 z-30 flex items-center gap-2 ${isRtl ? 'left-6' : 'right-6'}`}>
      {slides.map((_, index) => (
        <button 
          class={`h-2 rounded-full transition-all duration-300 indicator-dot ${index === 0 ? 'w-8 bg-[#D29D52]' : 'w-2 bg-white/30'}`}
          data-index={index}
          aria-label={isRtl ? `الانتقال إلى الشريحة ${index + 1}` : `Go to slide ${index + 1}`}
        ></button>
      ))}
    </div>

  </div>
</div>

<style>
  @keyframes shine {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .animate-shine {
    animation: shine 5s ease infinite;
  }

  /* Arabic text needs an Arabic-covering font — the rest of the site's
     Tailwind font stack has no Arabic glyphs. Scoped to this slider only,
     no effect when lang="en" (the default). */
  .hero-slider.is-rtl {
    font-family: 'IBM Plex Sans Arabic', system-ui, sans-serif;
  }
</style>

<!-- Loaded unconditionally but tiny; only actually used when is-rtl is present -->
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;900&display=swap"
/>

<!-- Pass the frontmatter slideSpeed directly into the client script using Astro -->
<script define:vars={{ slideSpeed }}>
  const initSlider = () => {
    const sliderContainer = document.getElementById("slider-container");
    if (!sliderContainer) return;

    const slides = sliderContainer.querySelectorAll("[data-slide]");
    const dots = sliderContainer.querySelectorAll(".indicator-dot");
    let currentIndex = 0;
    const totalSlides = slides.length;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.remove("opacity-0", "z-0");
          slide.classList.add("opacity-100", "z-10");
        } else {
          slide.classList.remove("opacity-100", "z-10");
          slide.classList.add("opacity-0", "z-0");
        }
      });

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.remove("w-2", "bg-white/30");
          dot.classList.add("w-8", "bg-[#D29D52]");
        } else {
          dot.classList.remove("w-8", "bg-[#D29D52]");
          dot.classList.add("w-2", "bg-white/30");
        }
      });
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % totalSlides;
      showSlide(currentIndex);
    }

    function prevSlide() {
      currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      showSlide(currentIndex);
    }

    // Clear any previous interval to prevent stacking multiple timers
    if (window.sliderIntervalId) clearInterval(window.sliderIntervalId);
    window.sliderIntervalId = window.setInterval(nextSlide, slideSpeed);

    // Prevent duplicate event binding if astro:page-load fires multiple times
    if (!sliderContainer.dataset.listenerAttached) {
      sliderContainer.dataset.listenerAttached = "true";

      const isRtlContainer = sliderContainer.classList.contains("is-rtl");

      sliderContainer.addEventListener("click", (e) => {
        if (e.target.closest("button")) return;

        const rect = sliderContainer.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const clickedFirstHalf = clickX < rect.width / 2;

        if (isRtlContainer ? !clickedFirstHalf : clickedFirstHalf) {
          prevSlide();
        } else {
          nextSlide();
        }

        clearInterval(window.sliderIntervalId);
        window.sliderIntervalId = window.setInterval(nextSlide, slideSpeed);
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", (e) => {
          const indexAttr = e.currentTarget.getAttribute("data-index");
          if (indexAttr !== null) {
            currentIndex = parseInt(indexAttr);
            showSlide(currentIndex);
            clearInterval(window.sliderIntervalId);
            window.sliderIntervalId = window.setInterval(nextSlide, slideSpeed);
          }
        });
      });
    }
  };

  // Run on first load and handle Astro page transitions seamlessly
  initSlider();
  document.addEventListener("astro:page-load", initSlider);
</script>