---
import { Image } from 'astro:assets';

// ==========================================
// SLIDER IMAGES — imported from src/assets/slider
// ==========================================
import slider1Img from '../assets/slider/slider1.jpg';
import slider2Img from '../assets/slider/slider2.jpg';
import slider3Img from '../assets/slider/slider3.jpg';
import slider4Img from '../assets/slider/slider4.jpg';
import slider5Img from '../assets/slider/slider5.jpg';
import slider6Img from '../assets/slider/slider6.jpg';
import slider7Img from '../assets/slider/slider7.jpg';
import slider8Img from '../assets/slider/slider8.jpg';

// ==========================================
// SLIDER CONFIGURATION CONTROLS
// ==========================================

// 1. SPEED CONTROL (in milliseconds: 6000 = 6 seconds per slide)
const slideSpeed = 6000;

// 2. SIZE CONTROL (Tailwind max-width and height classes)
const sliderMaxWidth = "max-w-9xl"; // Try max-w-3xl, max-w-4xl, max-w-6xl
const sliderHeight = "h-[600px] sm:h-[700px]"; // Adjust height for mobile/desktop

// 3. POSITION / ALIGNMENT CONTROL (Tailwind margins/padding)
const sliderAlignment = "mx-auto mt-[75px] mb-[5px]"; // shifted down another ~10%; total (75+5=80px) still unchanged from the original my-10, so no layout shift

// ==========================================

const slides = [
  {
    image: slider1Img,
    tag: "ERP Systems",
    title: "Digitize your business with a customized ERP system",
    description: "We work directly with your team to set up a system that run smoothly"
  },
  {
    image: slider5Img,
    tag: "IT Project Management",
    title: "Precision tracking from blueprint to launch.",
    description: "Clear timelines and step-by-step execution so your projects always launch on schedule."
  },
  {
    image: slider6Img,
    tag: "E-Taxes Solutions",
    title: "Full Integration with the Egyptian Tax Authority (ETA)",
    description: "Integrate with our financial team and enjoy a seamless workflow managed through state-of-the-art software "
  },
  {
    image: slider4Img,
    tag: "Website Development",
    title: "High-performance web systems",
    description: "High-performance websites and web applications engineered for seamless, device-agnostic experiences."
  },
  {
    image: slider7Img,
    tag: "Mobile App Development",
    title: "High-performance mobile applications",
    description: "We build custom apps for phones and tablets that look great and work smoothly on all devices."
  },
  {
    image: slider8Img,
    tag: "IT Infrastructure",
    title: "Secure Infrastructure & Smart Networking",
    description: "Reliable virtual servers, high-speed networks, and advanced monitoring systems like CCTV and control rooms to keep your business safe and always online."
  }
];
---

<!-- Position and Size applied via variables -->
<div class={`${sliderMaxWidth} ${sliderAlignment} px-4 sm:px-6`}>
  <div id="slider-container" class={`relative w-full ${sliderHeight} rounded-2xl overflow-hidden border border-white/10 shadow-2xl group cursor-pointer`}>
    
    <!-- Slides Container -->
    <div class="relative w-full h-full">
      {slides.map((slide, index) => (
        <div 
          class={`absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
          data-slide={index}
        >
          <!-- Background Image with Subtle Zoom & Dark Gradient Overlays -->
          <Image
            src={slide.image}
            alt={slide.tag}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 ease-out pointer-events-none"
            loading={index === 0 ? "eager" : "lazy"}
            widths={[480, 768, 1200, 1920]}
            sizes="100vw"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#08080a] via-[#08080a]/60 to-transparent pointer-events-none"></div>
          <div class="absolute inset-0 bg-black/30 pointer-events-none"></div>

          <!-- Text Content Overlay -->
          <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-10 max-w-3xl z-20 pointer-events-none">
            
            <!-- MASSIVE CATCHY TAG -->
            <div class="mb-3 inline-block">
              <span class="text-2xl sm:text-4xl font-black uppercase tracking-tight bg-gradient-to-r from-[#ff6a2b] via-[#ffa447] to-[#ff6a2b] bg-[length:200%_auto] bg-clip-text text-transparent animate-shine drop-shadow-[0_0_25px_rgba(255,106,43,0.3)]">
                {slide.tag}
              </span>
            </div>

            <!-- Smaller Secondary Title -->
            <h3 class="text-base sm:text-xl font-semibold text-white/90 tracking-wide mb-2 flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-[#ff6a2b] animate-pulse"></span>
              {slide.title}
            </h3>

            <!-- Description -->
            <p class="text-sm sm:text-base text-[#A3A3AA] leading-relaxed">
              {slide.description}
            </p>

          </div>
        </div>
      ))}
    </div>

    <!-- Pagination Indicators / Dots -->
    <div class="absolute bottom-6 right-6 z-30 flex items-center gap-2">
      {slides.map((_, index) => (
        <button 
          class={`h-2 rounded-full transition-all duration-300 indicator-dot ${index === 0 ? 'w-8 bg-[#ff6a2b]' : 'w-2 bg-white/30'}`}
          data-index={index}
          aria-label={`Go to slide ${index + 1}`}
        ></button>
      ))}
    </div>

  </div>
</div>

<style>
  @keyframes shine {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .animate-shine {
    animation: shine 5s ease infinite;
  }
</style>

<!-- Pass the frontmatter slideSpeed directly into the client script using Astro -->
<script define:vars={{ slideSpeed }}>
  const initSlider = () => {
    const sliderContainer = document.getElementById("slider-container");
    if (!sliderContainer) return;

    const slides = sliderContainer.querySelectorAll("[data-slide]");
    const dots = sliderContainer.querySelectorAll(".indicator-dot");
    let currentIndex = 0;
    const totalSlides = slides.length;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.remove("opacity-0", "z-0");
          slide.classList.add("opacity-100", "z-10");
        } else {
          slide.classList.remove("opacity-100", "z-10");
          slide.classList.add("opacity-0", "z-0");
        }
      });

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.remove("w-2", "bg-white/30");
          dot.classList.add("w-8", "bg-[#ff6a2b]");
        } else {
          dot.classList.remove("w-8", "bg-[#ff6a2b]");
          dot.classList.add("w-2", "bg-white/30");
        }
      });
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % totalSlides;
      showSlide(currentIndex);
    }

    function prevSlide() {
      currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      showSlide(currentIndex);
    }

    // Clear any previous interval to prevent stacking multiple timers
    if (window.sliderIntervalId) clearInterval(window.sliderIntervalId);
    window.sliderIntervalId = window.setInterval(nextSlide, slideSpeed);

    // Prevent duplicate event binding if astro:page-load fires multiple times
    if (!sliderContainer.dataset.listenerAttached) {
      sliderContainer.dataset.listenerAttached = "true";

      sliderContainer.addEventListener("click", (e) => {
        if (e.target.closest("button")) return;

        const rect = sliderContainer.getBoundingClientRect();
        const clickX = e.clientX - rect.left;

        if (clickX < rect.width / 2) {
          prevSlide();
        } else {
          nextSlide();
        }

        clearInterval(window.sliderIntervalId);
        window.sliderIntervalId = window.setInterval(nextSlide, slideSpeed);
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", (e) => {
          const indexAttr = e.currentTarget.getAttribute("data-index");
          if (indexAttr !== null) {
            currentIndex = parseInt(indexAttr);
            showSlide(currentIndex);
            clearInterval(window.sliderIntervalId);
            window.sliderIntervalId = window.setInterval(nextSlide, slideSpeed);
          }
        });
      });
    }
  };

  // Run on first load and handle Astro page transitions seamlessly
  initSlider();
  document.addEventListener("astro:page-load", initSlider);
</script>